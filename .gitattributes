# Files whose exact bytes are bound by a recorded sha256 (rule admission manifests, FX quote
# sources, retired corrections kept "with original bytes"). Git must never convert their line
# ends, or the same commit hashes differently on Windows and Linux. "-text" stores and checks
# out the bytes exactly as committed. Add a path here BEFORE committing a new hash-bound file.
data/reference/monetary_conversion/** -text
data/overrides/**/_retired_*.json -text
# Review records beside retired files are not hash-bound: leave them to git's normal handling.
data/overrides/**/_retired_*.review.json !text
# Text slice R: the SOFR seed copy, its sha256 recorded in warehouse/dbt_project.yml (sofr_seed_sha256).
warehouse/seeds/sofr_90day_avg.csv -text
# Text slice R phase 2: the base-rate seeds, sha256 recorded in warehouse/dbt_project.yml (base_rate_*_sha256).
warehouse/seeds/base_rate_fred.csv -text
warehouse/seeds/base_rate_series.csv -text
