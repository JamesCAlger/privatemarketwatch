{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evergreen.local/schemas/sc_toi_review/verdict.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "cik",
    "category",
    "verdict",
    "confidence",
    "primary_justification",
    "evidence_refs",
    "filing_tags",
    "affected_fields",
    "parser_gap_mechanism",
    "proposed_pattern",
    "false_positive_risk",
    "changed_files",
    "tests_validation_plan",
    "requires_human_merge",
    "missing_evidence",
    "residual_risk",
    "reviewer_notes"
  ],
  "properties": {
    "review_id": { "type": "string", "minLength": 1 },
    "cik": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "verdict": {
      "type": "string",
      "enum": [
        "NO_RESULTS_EXPECTED",
        "PARSER_PATTERN_PROPOSED",
        "STRUCTURE_UNSUPPORTED",
        "OUT_OF_SCOPE_THIRD_PARTY",
        "INSUFFICIENT_EVIDENCE",
        "ESCALATE"
      ]
    },
    "confidence": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
    "primary_justification": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "filing_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accession_number", "offer_role_tag", "confidence", "evidence_refs"],
        "properties": {
          "accession_number": { "type": "string", "minLength": 1 },
          "offer_role_tag": {
            "type": "string",
            "enum": ["issuer_self_tender", "third_party_tender", "not_final_or_no_results", "unknown_role", "missing_html"]
          },
          "confidence": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "subject_company": { "type": "string" },
          "offeror": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "affected_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "shares_tendered",
          "shares_accepted",
          "repurchase_price_per_share",
          "offer_expiration_date",
          "proration_pct",
          "shares_offered",
          "tx_valuation"
        ]
      },
      "uniqueItems": true
    },
    "parser_gap_mechanism": { "type": "string" },
    "proposed_pattern": { "type": "string" },
    "false_positive_risk": { "type": "string" },
    "changed_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "tests_validation_plan": { "type": "string" },
    "requires_human_merge": { "type": "boolean" },
    "missing_evidence": { "type": "string" },
    "residual_risk": { "type": "string", "minLength": 1 },
    "reviewer_notes": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "verdict": { "const": "PARSER_PATTERN_PROPOSED" } },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "evidence_refs": { "minItems": 1 },
          "affected_fields": { "minItems": 1 },
          "parser_gap_mechanism": { "minLength": 1 },
          "proposed_pattern": { "minLength": 1 },
          "false_positive_risk": { "minLength": 1 },
          "tests_validation_plan": { "minLength": 1 },
          "requires_human_merge": { "const": true }
        }
      }
    },
    {
      "if": {
        "properties": { "verdict": { "enum": ["INSUFFICIENT_EVIDENCE", "ESCALATE"] } },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "missing_evidence": { "minLength": 10 }
        }
      }
    }
  ]
}
