{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bdc-xbrl-html-section-bridge.v1",
  "title": "BDC XBRL static HTML section bridge",
  "type": "object",
  "required": ["schema_version", "cik", "version", "source", "bridges"],
  "properties": {
    "schema_version": {"const": "bdc-xbrl-html-section-bridge.v1"},
    "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
    "entity_name": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "source": {"const": "bdc_xbrl"},
    "bridges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "accession_number",
          "report_date",
          "raw_id_lower",
          "issuer_name",
          "instrument_description",
          "family",
          "html_sha256",
          "table_index",
          "section_row_index",
          "row_index",
          "cell_indices",
          "section_label",
          "match_evidence"
        ],
        "properties": {
          "accession_number": {"type": "string", "minLength": 1},
          "report_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "raw_id_lower": {"type": "string", "minLength": 1},
          "issuer_name": {"type": "string", "minLength": 1},
          "instrument_description": {"type": "string", "minLength": 1},
          "family": {"type": "string", "enum": ["debt", "equity", "warrant", "fund", "mixed"]},
          "html_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "table_index": {"type": "integer", "minimum": 0},
          "section_row_index": {"type": "integer", "minimum": 0},
          "row_index": {"type": "integer", "minimum": 0},
          "cell_indices": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0},
            "minItems": 1
          },
          "section_label": {"type": "string", "minLength": 1},
          "permit_overwrite": {
            "type": "boolean",
            "description": "Default false. When false, staging fills or repairs blank parsed instruments only."
          },
          "match_evidence": {
            "type": "object",
            "required": ["matched_terms"],
            "properties": {
              "matched_terms": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 1
              },
              "fair_value_matched": {"type": "boolean"},
              "cost_matched": {"type": "boolean"},
              "shares_matched": {"type": "boolean"},
              "principal_matched": {"type": "boolean"},
              "notes": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
