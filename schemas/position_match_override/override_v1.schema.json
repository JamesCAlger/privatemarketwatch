{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evergreen.local/schemas/position_match_override/override_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cik", "updated_at", "overrides"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "position-match-override.v1"
    },
    "cik": {
      "type": "string",
      "minLength": 1,
      "description": "10-digit zero-padded CIK"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO date of last update"
    },
    "overrides": {
      "type": "array",
      "items": { "$ref": "#/$defs/override_entry" }
    }
  },
  "$defs": {
    "override_entry": {
      "type": "object",
      "required": [
        "action",
        "begin_report_date",
        "end_report_date",
        "begin_issuer_name",
        "end_issuer_name",
        "begin_fair_value",
        "end_fair_value",
        "match_method",
        "mechanism",
        "evidence",
        "confidence",
        "residual_risk",
        "created_by",
        "review_id"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": ["reject", "force_pair"]
        },
        "begin_report_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "end_report_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "begin_issuer_name": {
          "type": "string",
          "minLength": 1
        },
        "end_issuer_name": {
          "type": "string",
          "minLength": 1
        },
        "begin_fair_value": {
          "type": "string",
          "minLength": 1,
          "description": "Fair value as string for exact matching"
        },
        "end_fair_value": {
          "type": "string",
          "minLength": 1,
          "description": "Fair value as string for exact matching"
        },
        "match_method": {
          "type": "string",
          "minLength": 1,
          "description": "Original match tier (e.g. C_normalized_name, D_fuzzy)"
        },
        "mechanism": {
          "type": "string",
          "minLength": 1,
          "description": "Root cause mechanism for this override"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Source evidence supporting this override"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "residual_risk": {
          "type": "string",
          "minLength": 1
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "replace_end_issuer_name": {
          "type": "string",
          "description": "Required for force_pair: replacement end issuer name"
        },
        "replace_end_fair_value": {
          "type": "string",
          "description": "Required for force_pair: replacement end fair value"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "action": { "const": "force_pair" } },
            "required": ["action"]
          },
          "then": {
            "required": ["replace_end_issuer_name", "replace_end_fair_value"],
            "properties": {
              "replace_end_issuer_name": { "minLength": 1 },
              "replace_end_fair_value": { "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
