    "leaf_marker_re": "^\\W*\\w*vestments,?\\s+Investments\\s*-+\\s*non-controlled\\s*/\\s*non-affiliated?\\s*,\\s*(?:Equity|Preferred\\s+Equity|Common\\s+Equity),\\s*(?!Total\\b)[^,]+,\\s*(?!Total\\b)\\S|\\bType\\s+\\w|\\bClass\\s+[A-Z0-9-]+\\b|\\b(?:Preferred|Common)\\s+(?:Units|Stock)\\b|\\bFloating\\s+Rate\\s+Note\\b|\\bCollateralized\\s+Loan\\s+Obligation\\b|\\b(?:Equity|Partnership)\\s+Interests?\\b"
