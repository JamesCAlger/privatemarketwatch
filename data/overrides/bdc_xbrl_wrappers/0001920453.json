  "known_edge_cases": [
    {
      "id": "affiliation_phrase_heading_leak",
      "description": "2023-12-31..2025-03-31 identifiers carry an affiliation phrase after 'Investments Investments' ('- non-controlled / non-affiliate', with spacing/dash variants). v1 stripped only 'Investments Investments', so category_marker_re (start-anchored) missed the 'First Lien Debt <Industry>' heading rows and the leaf marker 'first lien' published them as positions (fund total about 2x fund_financials). v2 strips the affiliation phrase as part of the prefix. The negative lookahead in category_marker_re keeps instrument-bearing all-alphabetic leaves (e.g. 'Conair Holdings LLC Delayed Draw Term Loan', 2024-06-30) from being demoted.",
      "first_seen_quarter": "2023-12-31",
      "detection_pattern": "^Investments Investments -{1,2} non-controlled ?/? ?non-affiliate (First|Second) Lien Debt",
      "disposition": "expected"
    }
  ],
