{
  "schema_version": "bdc-xbrl-wrapper.v3",
  "cik": "0001920453",
  "entity_name": "Fidelity Private Credit Fund",
  "version": 1,
  "source": "bdc_xbrl",
  "dispatch": {
    "rule_prefix": "FIDELITY_PRIVATE_CREDIT",
    "prefix_rules": {
      "Investments Investments": "debt"
    },
    "aggregate_markers": [
      "total investments",
      "total debt investments",
      "total equity investments",
      "investment portfolio",
      "total investment portfolio",
      "non-controlled / non-affiliate first lien debt"
    ],
    "non_private_markers": [
      "cash",
      "money market",
      "financial square",
      "government institutional",
      "u.s. treasury",
      "us treasury",
      "mutual fund",
      "floating rate central fund",
      "high income central fund"
    ]
  },
  "staging": {
    "strategy": "hierarchy_leaf_guard",
    "leaf_guard": {
      "type_industry_prefix_re": "(?i)^(?:(?:First|Second)\\s+Lien\\s+Debt|Debt|Equity|Preferred\\s+Equity|Common\\s+Equity)?\\s*(?:INDUSTRY_LABELS)\\s+",
      "marker_re": "(?:first[-\\s]lien|second[-\\s]lien|unitranche|term\\s+loan|delayed\\s+draw(?:\\s+term\\s+loan)?|revolving\\s+credit\\s+facility|revolver|secured\\s+loan|type\\s+(?:term\\s+loan|delayed\\s+draw\\s+term\\s+loan|revolving\\s+credit\\s+facility)|class\\s+[a-z0-9-]+|preferred\\s+units|partnership\\s+interest|common\\s+stock|preferred\\s+stock|ordinary\\s+shares|structured\\s+product|warrants?)",
      "evidence_re": "\\b(interest\\s+rate|reference\\s+rate|sofr|libor|euribor|maturity|due|initial\\s+acquisition\\s+date|acquisition\\s+date|par|shares?|units?)\\b"
    }
  },
  "archetypes": {
    "debt": {
      "description": "All debt instruments: first/second lien, term loans, delayed draws, revolvers",
      "detection_rules": {
        "keywords": [
          "First Lien Debt",
          "Second Lien Debt",
          "First Lien",
          "Second Lien",
          "Term Loan",
          "Delayed Draw",
          "Revolving Credit Facility",
          "Revolver",
          "Unitranche",
          "Senior Secured",
          "Subordinated",
          "Corporate Bond",
          "Senior Note"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    },
    "equity": {
      "description": "Equity instruments: common/preferred stock, units, partnership interests",
      "detection_rules": {
        "keywords": [
          "Common Stock",
          "Preferred Stock",
          "Common Units",
          "Preferred Units",
          "Common Equity",
          "Preferred Equity",
          "Partnership Interest",
          "LLC Interest",
          "Membership Interest",
          "Equity Interest",
          "Class A Units",
          "Class A Common",
          "Class B Units",
          "Ordinary Shares",
          "Limited Partner"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    },
    "warrant": {
      "description": "Warrants and options on equity",
      "detection_rules": {
        "keywords": [
          "Warrant",
          "Warrants"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    }
  },
  "invariants": {
    "unclassified_rate": {
      "max_pct": 0.10
    }
  }
}
