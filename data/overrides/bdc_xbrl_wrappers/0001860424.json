    "hierarchy_instrument_re": "(?i)^\\s*(?:Non-controlled/Non-affiliated\\s+investments\\s+)?(?:Debt\\s+Investments|Equity)\\s+(?:Non-controlled/Non-affiliated\\s+investments\\s+Debt\\s+Investments\\s+)?(?:MSD_INDUSTRY_LABELS)\\s+.+?\\s+((?:Initial\\s+Term\\s+Loan|Closing\\s+Date\\s+Dollar\\s+Term\\s+Loan|Closing\\s+Date\\s+Initial\\s+Term\\s+Loan|Second\\s+Amendment\\s+Incremental\\s+Term\\s+Loan|Ninth\\s+Amendment\\s+Dollar\\s+Refinancing\\s+Term\\s+Loan|Eight\\s+Amendment\\s+Term\\s+Loan|2024\\s+Refinancing\\s+Term\\s+Loan|2024-2\\s+Term\\s+Loan|[A-Za-z0-9 -]+\\s+Term\\s+Loan|Term\\s+A\\s+Loan|Term\\s+Loan\\s*B|Term\\s+Loan\\s+B|Term\\s+B-2|Term\\s+B\\s+Loan(?:\\s+\\(2024\\))?|Tranche\\s+B\\s+Loan|Incremental\\s+TL|Term\\s+Facility|Incremental\\s+Term\\s+Facility|Term\\s+Loan|Delayed\\s+Draw\\s+Term\\s+Loan|Additional\\s+DDTL|Designated\\s+DDTL|Future\\s+Expansion\\s+DDTL|Advance\\s+Revolver|Revolver|Initial\\s+Revolving\\s+Credit|Initial\\s+Revolving\\s+Credit\\s+Facility|Revolving\\s+Credit\\s+Loan|Revolving\\s+Credit\\s+Facility|Revolving\\s+Loan|Additional\\s+Revolving\\s+Commitment|Extended\\s+Facility\\s+B(?:\\s+\\(USD\\))?|Initial\\s+USD\\s+Term\\s+Loan|HoldCoTerm\\s+Loan|Class\\s+[A-Za-z0-9 -]+\\s+Equity|Common\\s+Equity|Common\\s+Stock|Common\\s+Units|Preferred\\s+Equity|Preferred\\s+Units|Class\\s+[A-Za-z0-9 -]+\\s+(?:common\\s+)?units|Series\\s+[A-Za-z0-9 -]+\\s+Preferred\\s+Units|Equity\\s+Interest|Warrants?)\\b.*?)(?:\\s+Reference\\s+Rate\\s+and\\s+Spread\\s+|\\s+Interest\\s+Rate\\s+|\\s+Initial\\s+Acquisition\\s+Date\\s*|\\s+Acquisition\\s+Date\\s+|\\s+Maturity\\s+Date\\s*|$)",
    "hierarchy_condition_extra": "regexp_matches(_clean, '(?i)^\\s*(?:Non-controlled/Non-affiliated\\s+investments\\s+)?(?:Debt\\s+Investments|Equity)\\s+') AND NOT regexp_matches(_clean, '(?i)^\\s*Non-cNon-controlled/Non-affiliated\\s+investments\\s+Debt\\s+Investments\\b') AND regexp_matches(_clean, '(?i)\\b(?:Initial\\s+Term\\s+Loan|Closing\\s+Date\\s+Dollar\\s+Term\\s+Loan|Closing\\s+Date\\s+Initial\\s+Term\\s+Loan|Second\\s+Amendment\\s+Incremental\\s+Term\\s+Loan|Ninth\\s+Amendment\\s+Dollar\\s+Refinancing\\s+Term\\s+Loan|Eight\\s+Amendment\\s+Term\\s+Loan|2024\\s+Refinancing\\s+Term\\s+Loan|2024-2\\s+Term\\s+Loan|[A-Za-z0-9 -]+\\s+Term\\s+Loan|Term\\s+A\\s+Loan|Term\\s+Loan\\s*B|Term\\s+Loan\\s+B|Term\\s+B-2|Term\\s+B\\s+Loan(?:\\s+\\(2024\\))?|Tranche\\s+B\\s+Loan|Incremental\\s+TL|Term\\s+Facility|Incremental\\s+Term\\s+Facility|Term\\s+Loan|Delayed\\s+Draw\\s+Term\\s+Loan|Additional\\s+DDTL|Designated\\s+DDTL|Future\\s+Expansion\\s+DDTL|Advance\\s+Revolver|Revolver|Initial\\s+Revolving\\s+Credit|Initial\\s+Revolving\\s+Credit\\s+Facility|Revolving\\s+Credit\\s+Loan|Revolving\\s+Credit\\s+Facility|Revolving\\s+Loan|Additional\\s+Revolving\\s+Commitment|Extended\\s+Facility\\s+B(?:\\s+\\(USD\\))?|Initial\\s+USD\\s+Term\\s+Loan|HoldCoTerm\\s+Loan|Class\\s+[A-Za-z0-9 -]+\\s+Equity|Common\\s+Equity|Common\\s+Stock|Common\\s+Units|Preferred\\s+Equity|Preferred\\s+Units|Class\\s+[A-Za-z0-9 -]+\\s+(?:common\\s+)?units|Series\\s+[A-Za-z0-9 -]+\\s+Preferred\\s+Units|Equity\\s+Interest|Warrants?)\\b') AND regexp_matches(_clean, '(?i)(?:Reference\\s+Rate\\s+and\\s+Spread|Interest\\s+Rate|Initial\\s+Acquisition\\s+Date|Acquisition\\s+Date|Maturity\\s+Date|Common\\s+Equity|Preferred\\s+Equity|Common\\s+Units|Preferred\\s+Units|Warrants?)')",
