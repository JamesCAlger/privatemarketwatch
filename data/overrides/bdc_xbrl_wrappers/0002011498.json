    "hierarchy_issuer_re": "(?i)^\\s*(?:(?:Investments\\s+)?(?:Non-controlled/(?:Non-)?affiliated\\s+)?(?:(?:Debt|debt|Equity|equity)\\s+investments|investments)\\s+(?:Industry\\s+(?:MSD_INDUSTRY_LABELS)\\s+)?|Investments\\s+Industry\\s+(?:MSD_INDUSTRY_LABELS)\\s+|Industry\\s+(?:MSD_INDUSTRY_LABELS)\\s+)(.+?)\\s+(?:(?:First\\s+Lien|Second\\s+Lien)\\b|LP\\s+Interest\\b|Acquisition\\s+Date\\b)",
    "hierarchy_instrument_re": "(?i)^\\s*.*?((?:(?:First\\s+Lien|Second\\s+Lien)\\s+)+(?:Delayed\\s+Draw\\s+)?(?:Revolving\\s+Loan|Term\\s+Loan(?:\\s+#\\d+)?|Delayed\\s+Draw\\s+Term\\s+Loan(?:\\s+#\\d+)?).*|LP\\s+Interest(?:\\s+Industry\\s+(?:MSD_INDUSTRY_LABELS))?.*|Equity\\s+investments.*)$",
    "hierarchy_condition_extra": "regexp_matches(_clean, '(?i)^\\s*(?:Investments|Industry)') AND regexp_matches(_clean, '(?i)\\b(?:First\\s+Lien|Second\\s+Lien|LP\\s+Interest|Equity\\s+investments)\\b') AND regexp_matches(_clean, '(?i)\\b(?:Reference\\s+Rate|Acquisition\\s+Date|Maturity\\s+Date)\\b')"
