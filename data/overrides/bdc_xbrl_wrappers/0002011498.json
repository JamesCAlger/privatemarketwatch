ialty\\s+Retail|Trading\\s+Companies\\s+&\\s+Distributors)|\\bFirst\\s+Lien\\b|\\s+Reference\\s+Rate\\s+and\\s+Spread\\s+(?:SOFR\\s*\\+\\s*|PRIME\\s*\\+?)?\\d+(?:\\.\\d+)?%?|\\s+All\\s+In\\s+Rate\\s+\\d+(?:\\.\\d+)?%?(?:\\s*cash\\s*/\\s*\\d+(?:\\.\\d+)?%?\\s*PIK)?|\\s+Acquisition\\s+Date\\s+\\d{1,2}/\\d{1,2}/\\d{4}|\\s+Maturity\\s+Date\\s+\\d{1,2}/\\d{1,2}/\\d{4}"
  },
  "identifier_format": {
