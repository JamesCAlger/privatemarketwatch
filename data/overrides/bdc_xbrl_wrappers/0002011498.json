  "known_edge_cases": [
    {
      "id": "asset_family_prefix_drift",
      "description": "The same debt facilities appear with several hierarchy prefixes, including plain investments, debt investments, and Industry-first variants; canonical keys strip those prefixes.",
      "first_seen_quarter": "2024-12-31",
      "detection_pattern": "Non-controlled/Non-affiliated (debt )?investments|Investments Industry|^Industry",
      "disposition": "expected"
    },
    {
      "id": "duplicated_first_lien_token",
      "description": "Some parsed rows include First Lien twice after the debt-investments hierarchy prefix; canonical keys remove only the duplicated leading token so facility type remains in the key.",
      "first_seen_quarter": "2025-03-31",
      "detection_pattern": "First Lien First Lien",
      "disposition": "expected"
    },
    {
      "id": "affiliated_investment_fund_equity",
      "description": "AGL EPCI I is disclosed as a non-controlled/affiliated equity investment-fund position with cost, fair value, pct-of-net-assets, and acquisition-date facts.",
      "first_seen_quarter": "2026-03-31",
      "detection_pattern": "AGL EPCI I",
      "disposition": "warn"
    }
