          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    },
    "equity": {
      "description": "Equity and fund-interest positions including ABF equity, common stock, preferred equity, private equity, and partnership interests.",
      "detection_rules": {
        "keywords": [
          "ABF Equity",
          "Preferred Equity",
          "Common Stock",
          "Partnership Interest",
          "Private Equity",
          "Common Equity",
          "Preferred Stock",
          "Equity Interest"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    },
    "warrant": {
      "description": "Warrants and similar equity-linked instruments.",
      "detection_rules": {
        "keywords": [
          "Warrant",
          "Warrants"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    }
  },
  "known_edge_cases": [
    {
      "id": "kkr_fs_select_affiliated_issuer_pipe_rows",
      "description": "Latest-quarter affiliated rows use an affiliation prefix followed by issuer and instrument text, for example 'Affiliated Issuer | Discover Financial Services, Subordinated Loan'. The canonical key strips only the affiliation prefix so position matching remains issuer-specific.",
      "first_seen_quarter": "2025-12-31",
      "detection_pattern": "^(?:Affiliated|Non-Affiliated) Issuer \\| ",
      "disposition": "expected"
    },
    {
      "id": "kkr_fs_select_industry_tranche_only_debt_rows",
      "description": "Many debt positions disclose issuer plus industry/tranche number without an explicit instrument label, e.g. 'A-Lign Assurance LLC | Software & Services 1'. These rows carry debt economics such as basis spread, principal amount, cost, and fair value.",
      "first_seen_quarter": "2024-03-31",
      "detection_pattern": "(?:\\||,) [A-Za-z&, ]+ [0-9]+$",
      "disposition": "expected"
    }
  ],
  "invariants": {
    "unclassified_rate": {
      "max_pct": 0.05
    }
  }
