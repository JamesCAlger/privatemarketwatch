    ],
    "non_private_markers": [
      "cash and cash equivalents",
      "money market",
      "government fund",
      "u.s. treasury",
      "us treasury"
    ],
    "fallback_family_patterns": [
      {
        "regex": "(?i)\\bWarrants?\\b",
        "family": "warrant"
      },
      {
        "regex": "(?i)\\b(?:ABF\\s+Equity|Preferred\\s+Equity|Common\\s+Stock|Partnership\\s+Interest|Private\\s+Equity|Common\\s+Equity|Preferred\\s+Stock|Equity\\s+Interest)\\b",
        "family": "equity"
      },
      {
        "regex": "(?i)\\b(?:Term\\s+Loan|Revolver|Revolving|Bond|Structured\\s+Mezzanine|Subordinated\\s+Loan|Senior\\s+Secured|First\\s+Lien|Second\\s+Lien|Delayed\\s+Draw|Notes?|Loan|Debt|ABS|CLO)\\b",
        "family": "debt"
      },
      {
        "regex": "(?i)(?:\\||,)\\s*(?:Capital\\s+Goods|Commercial\\s+&\\s+Professional\\s+Services|Consumer\\s+Services|Consumer\\s+Discretionary\\s+Distribution\\s+&\\s+Retail|Consumer\\s+Durables\\s+&\\s+Apparel|Consumer\\s+Staples\\s+Distribution\\s+&\\s+Retail|Energy|Financial\\s+Services|Food\\s+&\\s+Staples\\s+Retailing|Food,\\s*Beverage\\s+&\\s+Tobacco|Health\\s+Care\\s+Equipment\\s+&\\s+Services|Household\\s+&\\s+Personal\\s+Products|Insurance|Materials|Media\\s+&\\s+Entertainment|Pharmaceuticals,\\s*Biotechnology\\s+&\\s+Life\\s+Sciences|Real\\s+Estate\\s+Management\\s+&\\s+Development|Software\\s+&\\s+Services|Technology\\s+Hardware\\s+&\\s+Equipment|Telecommunication\\s+Services|Transportation|Utilities)(?:\\s+\\d+)?\\s*$",
        "family": "debt"
      },
      {
        "regex": "(?i)\\b(?:LLC|Inc|Corp|Ltd|LP|PA|DAC|Sarl|PLC|Group|Holdings)\\s+\\d+\\s*$",
        "family": "debt"
      },
      {
        "regex": "(?i)^(?!(?:Financial\\s+Services|Capital\\s+Goods|Consumer\\s+Services|Software\\s+&\\s+Services|Insurance|Materials|Transportation|Utilities)$)[A-Z0-9][A-Za-z0-9&.'()/-]+(?:\\s+[A-Za-z0-9&.'()/-]+){0,8}\\s+\\d+\\s*$",
        "family": "debt"
      },
      {
        "regex": "(?i)^(?:A-Lign\\s+Assurance\\s+LLC|Carrier\\s+Fire\\s+Protection|Discover\\s+Financial\\s+Services|Legends\\s+Hospitality\\s+LLC|MAI\\s+Capital\\s+Management\\s+LLC|Model\\s+N\\s+Inc|Netsmart\\s+Technologies\\s+Inc|Turnpoint\\s+Services\\s+Inc)(?:\\s*(?:\\||,)\\s+.*)?$",
        "family": "debt"
      }
    ],
    "canonical_strip_re": "(?i)^(?:Affiliated|Non-Affiliated)\\s+Issuer\\s*\\|\\s*",
    "category_marker_re": "(?i)^\\s*(?:Total\\s+)?(?:Investments?|Debt\\s+Investments|Equity\\s+Investments|Subtotal|Sub-Total|Investments\\s+(?:after|before)\\s+Cash\\s+Equivalents)\\s*$"
  },
  "identifier_format": {
    "delimiter": ", ",
    "field_order": [
      "issuer_name",
      "instrument_description"
    ],
    "alternate_delimiters": [
      " | "
    ]
  },
  "staging": {
    "strategy": "hierarchy_extract",
    "hierarchy_issuer_re": "(?i)^(?:(?:Affiliated|Non-Affiliated)\\s+Issuer\\s*\\|\\s*)?(.+?),\\s+.+$",
    "hierarchy_instrument_re": "(?i)^(?:(?:Affiliated|Non-Affiliated)\\s+Issuer\\s*\\|\\s*)?.+?,\\s+(.+)$",
    "hierarchy_condition_extra": "regexp_matches(_clean, '(?i)^(?:(?:Affiliated|Non-Affiliated)\\s+Issuer\\s*\\|\\s*)?.+?,\\s+.+$')"
  },
  "archetypes": {
    "debt": {
      "description": "Debt and structured-credit positions including term loans, revolvers, bonds, subordinated loans, ABS, and industry/tranche-only loan rows.",
      "detection_rules": {
        "keywords": [
          "Term Loan",
          "Revolver",
          "Bond",
          "Structured Mezzanine",
          "Subordinated Loan",
          "Senior Secured",
          "First Lien",
          "Second Lien",
          "ABS",
          "Software & Services",
          "Capital Goods",
          "Commercial & Professional Services",
          "Consumer Discretionary Distribution & Retail",
          "Consumer Durables & Apparel",
          "Consumer Services",
          "Consumer Staples Distribution & Retail",
          "Energy",
          "Financial Services",
          "Food & Staples Retailing",
          "Food, Beverage & Tobacco",
          "Health Care Equipment & Services",
          "Household & Personal Products",
          "Insurance",
          "Materials",
          "Media & Entertainment",
          "Pharmaceuticals, Biotechnology & Life Sciences",
          "Real Estate Management & Development",
          "Telecommunication Services",
          "Technology Hardware & Equipment",
          "Transportation",
          "Utilities"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
