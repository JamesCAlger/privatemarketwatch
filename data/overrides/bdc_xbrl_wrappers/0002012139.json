      "Pharmaceuticals, Biotechnology & Life Sciences",
      "Software",
      "Software & Services",
      "Specialty Retail",
      "Transportation",
      "Utilities"
    ]
  },
  "archetypes": {
    "debt": {
      "description": "Debt instruments including first-lien term loans, delayed draws, and revolving credit facilities with reference spread, current coupon, and maturity terms.",
      "detection_rules": {
        "keywords": [
          "First Lien",
          "Term Loan",
          "Delayed Draw",
          "Revolving Credit Facility",
          "SOFR",
          "EURIBOR"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        },
        "interest_rate": {
          "type": "numeric_range",
          "constraint": "optional",
          "min": 0.0,
          "max": 1.0
        }
      }
    },
    "equity": {
      "description": "Equity investments including class units, common equity, preferred equity, and equity interests.",
      "detection_rules": {
        "keywords": [
          "Class A Units",
          "Common Equity",
          "Preferred Equity",
          "Common Stock",
          "Preferred Stock",
          "Equity Interest"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    },
    "warrant": {
      "description": "Warrants and similar equity-linked instruments.",
      "detection_rules": {
        "keywords": [
          "Warrant",
          "Warrants"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    }
  },
  "known_edge_cases": [
    {
      "id": "fortress_affiliation_hierarchy_rows",
      "description": "Most identifiers prepend affiliation, asset class, and industry before issuer and instrument details.",
      "first_seen_quarter": "2025-06-30",
      "detection_pattern": "Investments Non-controlled, <affiliation> <asset class> investments <industry> <issuer> Investment <instrument>",
      "disposition": "expected"
    },
    {
      "id": "fortress_investment_type_rows",
      "description": "Some 2026 rows omit the affiliation hierarchy and use issuer Investment Type instrument labels.",
      "first_seen_quarter": "2026-03-31",
      "detection_pattern": "<issuer> Investment Type <instrument>",
      "disposition": "expected"
    },
    {
      "id": "fortress_bare_issuer_rows",
      "description": "A few bare issuer identifiers have no instrument evidence and remain unclassified for review rather than being promoted to position leaves.",
      "first_seen_quarter": "2025-12-31",
      "detection_pattern": "<issuer name>",
      "disposition": "warn"
    }
  ],
  "invariants": {
    "unclassified_rate": {
      "max_pct": 0.05
    }
  }
