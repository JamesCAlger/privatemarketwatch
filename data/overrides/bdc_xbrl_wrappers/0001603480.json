  "staging": {
    "strategy": "hierarchy_extract",
    "hierarchy_issuer_re": "(?i)^\\s*(?:(?:Debt|Equity)\\s+Investments-\\s+United\\s+States\\s+(?:(?:Distributors|Diversified\\s+Consumer\\s+Services|Diversified\\s+Financial\\s+Services|Hotels,\\s+Restaurants\\s+&\\s+Leisure|Household\\s+Durables|Industrial\\s+Conglomerates|Investment\\s+Funds\\s+&\\s+Vehicles|Metals\\s+&\\s+Mining|Pharmaceuticals|Technolog(?:y|ies)\\s+Hardware,\\s+Storage\\s+and\\s+Peripherals),?\\s+)+)?(.+?)\\s+(?:Date\\s+|(?:\\d+(?:st|nd|rd|th)\\s+Amendment\\s+|\\d{4}\\s+|First\\s+Out\\s+|Delayed\\s+Draw\\s+(?:Priming|Printing)\\s+|HoldCo\\s+|Incremental\\s+)?Term\\s+Loan|Subordinated\\s+Loan|Revolver(?:\\s+Opco)?|Class\\s+[A-Z][A-Z0-9-]*|P-[12]\\s+Units|Common\\s+(?:Stock|Shares|Units|membership\\s+Interests)|Preferred\\s+(?:Stock|Equity|Units|membership\\s+Interests)|Membership\\s+Interests|Warrants?)\\b",
    "hierarchy_instrument_re": "(?i)(?:\\bDate\\s+(?:\\d{1,2}/\\d{1,2}/\\d{2,4}(?:\\s*&\\s*\\d{1,2}/\\d{1,2}/\\d{2,4})?)\\s+|^\\s*(?:(?:Debt|Equity)\\s+Investments-\\s+United\\s+States\\s+(?:(?:Distributors|Diversified\\s+Consumer\\s+Services|Diversified\\s+Financial\\s+Services|Hotels,\\s+Restaurants\\s+&\\s+Leisure|Household\\s+Durables|Industrial\\s+Conglomerates|Investment\\s+Funds\\s+&\\s+Vehicles|Metals\\s+&\\s+Mining|Pharmaceuticals|Technolog(?:y|ies)\\s+Hardware,\\s+Storage\\s+and\\s+Peripherals),?\\s+)+)?.+?\\s+)((?:(?:\\d+(?:st|nd|rd|th)\\s+Amendment\\s+|\\d{4}\\s+|First\\s+Out\\s+|Delayed\\s+Draw\\s+(?:Priming|Printing)\\s+|HoldCo\\s+|Incremental\\s+)?Term\\s+Loan|Subordinated\\s+Loan|Revolver(?:\\s+Opco)?)(?:\\s+[A-Z])?|(?:Class\\s+[A-Z][A-Z0-9-]*\\s+Common|Class\\s+[A-Z][A-Z0-9-]*\\s+(?:Common\\s+)?(?:Preferred\\s+)?Units?|P-[12]\\s+Units|Common\\s+(?:Stock|Shares|Units|membership\\s+Interests)|Preferred\\s+(?:Stock|Equity|Units|membership\\s+Interests)|Membership\\s+Interests|Warrants?(?:,\\s*expires\\s*\\d{1,2}/\\d{1,2}/\\d{2,4})?)(?:.*?))\\s*(?:[-,]?\\s*\\d|\\s+Net\\s+Assets|\\s+Maturity\\b|$)",
    "hierarchy_condition_extra": "(regexp_matches(_clean, '(?i)^\\s*(?:Debt|Equity)\\s+Investments-\\s+United\\s+States\\s+.*\\b(?:Date|Term\\s+Loan|Subordinated\\s+Loan|Revolver|Common\\s+Stock|Common\\s+Shares|Common\\s+Units|Preferred\\s+(?:Stock|Equity|Units)|Preferred\\s+membership\\s+Interests|Common\\s+membership\\s+Interests|Class\\s+[A-Z][A-Z0-9-]*|P-[12]\\s+Units|Membership\\s+Interests|Warrants?)\\b') OR (regexp_matches(_clean, '(?i)^\\s*.*\\b(?:Term\\s+Loan|Subordinated\\s+Loan|Revolver|Common\\s+Stock|Common\\s+Shares|Common\\s+Units|Preferred\\s+(?:Stock|Equity|Units)|Preferred\\s+membership\\s+Interests|Common\\s+membership\\s+Interests|Class\\s+[A-Z][A-Z0-9-]*|P-[12]\\s+Units|Membership\\s+Interests|Warrants?)\\b') AND NOT regexp_matches(_clean, '(?i)^\\s*(?:Short-term\\s+Investments|Cash\\s+Equivalents|Total\\s+Investments)\\b')))",
    "extra_industry_labels": [
