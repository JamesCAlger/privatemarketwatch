    "category_marker_before_total": true,
    "canonical_strip_re": "(?i)\\s*[^A-Za-z0-9\\s/,]\\s*\\d+(?:\\.\\d+)?%.*?(?=\\s+Net\\s+Assets\\b|\\s+Maturity\\b)|\\s*[^A-Za-z0-9\\s/,]\\s*\\d+(?:\\.\\d+)?%.*$|\\s+Net\\s+Assets\\s+[-\\d.]+%?"
