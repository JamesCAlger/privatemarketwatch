        "family": "warrant"
      },
      {
        "regex": "(?i)\\b(?:First\\s+Lien|Second\\s+Lien|Senior\\s+Secured|Delayed\\s+Draw|Revolving\\s+Loan|Revolver|Term\\s+Loan|Sponsor\\s+Subordinated\\s+Note|Subordinated\\s+Note)\\b",
        "family": "debt"
      },
      {
        "regex": "(?i)^\\s*(?:Ascent\\s+Lifting,\\s+Inc\\.|NEFCO\\s+Holding\\s+Company,\\s+LLC),\\s+(?:Ascent\\s+Lifting,\\s+Inc\\.|NEFCO\\s+Holding\\s+Company,\\s+LLC)\\s+\\d+\\s*$",
        "family": "debt"
      },
      {
        "regex": "(?i)\\b(?:Equity\\s+Interest|Membership\\s+Interest|Common\\s+Stock|Preferred\\s+Stock|Common\\s+Equity|Preferred\\s+Equity)\\b|^\\s*Twin\\s+Brook\\s+(?:Segregated\\s+)?Equity\\s+Holdings,?\\s+LLC\\b",
        "family": "equity"
      },
      {
        "regex": "(?i)^\\s*(?:Total\\s+)?(?:Investments?|Debt\\s+Investments|Equity\\s+Investments)\\b",
        "family": "debt"
      }
    ],
    "category_marker_re": "(?i)^\\s*(?:Total\\s+)?(?:Investments?|Debt\\s+Investments|Equity\\s+Investments|Subtotal|Sub-Total)\\s*$"
  },
  "identifier_format": {
