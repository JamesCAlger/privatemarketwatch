      "detection_rules": {
        "keywords": [
          "First lien senior secured",
          "First lien senior secured delayed draw term loan",
          "First lien senior secured revolving loan",
          "First lien senior secured term loan",
          "Sponsor subordinated note",
          "Subordinated note",
          "Ascent Lifting",
          "NEFCO Holding Company"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        },
        "interest_rate": {
          "type": "numeric_range",
          "constraint": "optional",
          "min": 0.0,
          "max": 1.0
        }
      }
    },
    "equity": {
      "description": "Twin Brook equity holdings and explicitly disclosed equity-interest positions",
      "detection_rules": {
        "keywords": [
          "Equity interest",
          "Twin Brook Equity Holdings",
          "Twin Brook Segregated Equity Holdings",
          "Membership interest",
          "Common stock",
          "Preferred stock"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        },
        "interest_rate": {
          "type": "presence",
          "constraint": "forbidden"
        }
      }
    },
    "warrant": {
      "description": "Warrants and similar equity-linked instruments",
      "detection_rules": {
        "keywords": [
          "Warrant",
          "Warrants"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    }
  },
  "known_edge_cases": [
    {
      "id": "older_duplicate_issuer_only_rows",
      "description": "Seven 2023-06-30 rows use duplicate issuer-name identifiers for Ascent Lifting and NEFCO. They are matched positions with interest-rate, basis-spread, principal, cost, and fair-value facts, so the wrapper covers those two issuer patterns without adding a broad entity fallback.",
      "first_seen_quarter": "2023-06-30",
      "detection_pattern": "Issuer, Issuer [0-9]",
      "disposition": "expected"
    },
    {
      "id": "bare_twin_brook_equity_holdings",
      "description": "Bare Twin Brook Equity Holdings and Twin Brook Segregated Equity Holdings rows recur across quarters as equity positions, sometimes alongside explicit Equity interest variants.",
      "first_seen_quarter": "2023-03-31",
      "detection_pattern": "^Twin Brook (?:Segregated )?Equity Holdings, LLC",
      "disposition": "expected"
    }
  ],
  "invariants": {
    "unclassified_rate": {
      "max_pct": 0.01
    }
  }
