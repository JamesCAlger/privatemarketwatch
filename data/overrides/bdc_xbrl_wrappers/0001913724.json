      "issuer_name",
      "instrument_description"
    ],
    "alternate_delimiters": [
      ", "
    ]
  },
  "staging": {
    "strategy": "hierarchy_extract",
    "hierarchy_issuer_re": "(?i)^(.+),\\s+(?:First\\s+Lien|Second\\s+Lien|Senior\\s+Secured|Delayed\\s+Draw|Revolving\\s+Loan|Revolver|Term\\s+Loan|Sponsor\\s+Subordinated\\s+Note|Subordinated\\s+Note|Equity\\s+Interest|Membership\\s+Interest|Common\\s+Stock|Preferred\\s+Stock|Common\\s+Equity|Preferred\\s+Equity)(?:\\s|$)",
    "hierarchy_instrument_re": "(?i)^.+,\\s+((?:First\\s+Lien|Second\\s+Lien|Senior\\s+Secured|Delayed\\s+Draw|Revolving\\s+Loan|Revolver|Term\\s+Loan|Sponsor\\s+Subordinated\\s+Note|Subordinated\\s+Note|Equity\\s+Interest|Membership\\s+Interest|Common\\s+Stock|Preferred\\s+Stock|Common\\s+Equity|Preferred\\s+Equity)(?:\\s|$).*?)(?:,\\s*(?:Affiliated|Affiliated\\s+Issuer|Non-Affiliated|Non-Affiliated\\s+Issuer))?\\s*$",
    "hierarchy_condition_extra": "NOT contains(_clean, '|') AND regexp_matches(_clean, '(?i),\\s+(?:First\\s+Lien|Second\\s+Lien|Senior\\s+Secured|Delayed\\s+Draw|Revolving\\s+Loan|Revolver|Term\\s+Loan|Sponsor\\s+Subordinated\\s+Note|Subordinated\\s+Note|Equity\\s+Interest|Membership\\s+Interest|Common\\s+Stock|Preferred\\s+Stock|Common\\s+Equity|Preferred\\s+Equity)(?:\\s|$)')"
  },
  "archetypes": {
    "debt": {
