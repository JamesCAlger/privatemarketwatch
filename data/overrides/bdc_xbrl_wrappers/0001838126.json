          "BidCo",
          "TopCo",
          "MidCo",
          "OpCo",
          "BuyCo",
          "HoldCo",
          "Management",
          "Services",
          "Solutions"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    }
