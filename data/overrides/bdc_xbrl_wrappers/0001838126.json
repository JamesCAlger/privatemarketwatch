    "fallback_family_patterns": [
      {"regex": "(?i)\\bWarrant", "family": "warrant"},
      {"regex": "(?i)(?:Preferred Stock|Preferred Shares|Preferred Units|Common Stock|Common Units|Class A[- ]\\d*\\s*Units|Class [A-D]\\s+(?:Common )?Units|Ordinary Shares|LLC Interest|LP Interest|L\\.P\\. Interest|Membership Interest|Equity Interest|Class A Common Units)", "family": "equity"},
      {"regex": "(?i)(?:CLO|Class [A-E]\\d?R?\\d?|Subordinated Note)", "family": "clo"},
      {"regex": "(?i).", "family": "debt"}
    ],
    "canonical_strip_re": "\\s*\\|\\s*(?:Non-Affiliated Issuer|Affiliated Issuer|\\|\\s*Non-Affiliated Issuer|\\|\\s*Affiliated Issuer)\\s*$"
  },
  "archetypes": {
    "warrant": {
      "description": "Warrants on equity",
      "detection_rules": {
        "keywords": [
          "Warrant",
          "Warrants",
          "B-2 Warrants",
          "A-2 Warrants"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    },
    "clo": {
      "description": "CLO tranche investments: Class E, Class D, subordinated notes in CLO vehicles",
      "detection_rules": {
        "keywords": [
          "CLO",
          "Subordinated Note",
          "Class E"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    },
    "equity": {
      "description": "Equity instruments: preferred/common stock, units, partnership interests, LLC interests",
      "detection_rules": {
        "keywords": [
          "Preferred Stock",
          "Preferred Shares",
          "Preferred Units",
          "Common Stock",
          "Common Units",
          "Class A Common Units",
          "Class A Units",
          "Class A-1 Units",
          "Class A-2 Units",
          "Class A-3 Units",
          "Class D Units",
          "Ordinary Shares",
          "A2 Ordinary Shares",
          "LLC Interest",
          "LP Interest",
          "L.P. Interest",
          "Membership Interest",
          "Equity Interest"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    },
    "debt": {
      "description": "Direct lending positions: senior secured, unitranche, mezzanine. HPS uses bare company names without instrument keywords, so entity suffixes serve as catch-all debt markers. Checked last after warrant/CLO/equity.",
      "detection_rules": {
        "keywords": [
          "Term Loan",
          "Delayed Draw",
          "Revolving Credit",
          "Revolver",
          "Senior Note",
          "Corporate Bond",
          "Unitranche",
          ", Inc",
          " Inc.",
