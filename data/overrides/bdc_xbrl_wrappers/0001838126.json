  "known_edge_cases": [
    {
      "id": "HPS_PIPE_FORMAT_TRANSITION",
      "description": "Pipe-delimited affiliation suffix (| Non-Affiliated Issuer, | Affiliated Issuer) appeared in 2025-12-31. Earlier quarters have no pipe.",
      "first_seen_quarter": "2025-12-31",
      "detection_pattern": "\\|",
      "disposition": "expected"
    },
    {
      "id": "HPS_DOUBLE_PIPE",
      "description": "Some rows have double pipe before affiliation (e.g. 'Club Car Wash Preferred, LLC - Preferred Stock 1 | | Non-Affiliated Issuer')",
      "first_seen_quarter": "2025-12-31",
      "detection_pattern": "\\|\\s*\\|",
      "disposition": "expected"
    },
    {
      "id": "HPS_DOUBLE_SPACE_DASH",
      "description": "Some CLO/equity identifiers have double space before dash (e.g. 'Octagon 52 Ltd  - Class ER')",
      "first_seen_quarter": "2025-12-31",
      "detection_pattern": "\\s{2,}-\\s",
      "disposition": "expected"
    },
    {
      "id": "HPS_TRAILING_POSITION_NUMBER",
      "description": "Multiple positions in same issuer distinguished by trailing number (e.g. '123Dentist Inc 1', '123Dentist Inc 2'). Each is a separate loan/tranche.",
      "first_seen_quarter": "2023-03-31",
      "detection_pattern": "\\s+\\d+$",
      "disposition": "expected"
    }
  ],
  "invariants": {
    "unclassified_rate": {
      "max_pct": 0.10,
      "max_fv_pct": 0.10
    }
  }
}
