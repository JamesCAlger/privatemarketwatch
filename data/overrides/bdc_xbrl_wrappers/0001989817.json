  },
  "archetypes": {
    "debt": {
      "description": "Issuer-only HPS direct lending positions. HPS Corporate Capital Solutions often omits instrument text, so legal-entity signals and trailing position numbers identify leaves.",
      "detection_rules": {
        "keywords": [
          "Inc",
          "LLC",
          "Corp",
          "Limited",
          "Holdings",
          "Group",
          "Borrower",
          "Services",
          "Solutions",
          "Trust",
          "LLP"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    },
    "equity": {
      "description": "Equity instruments when explicitly labeled as stock, units, interests, or shares.",
      "detection_rules": {
        "keywords": [
          "Preferred Stock",
          "Common Units",
          "Class A Units",
          "Equity Interest",
          "Membership Interest"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    },
    "warrant": {
      "description": "Warrant positions when explicitly labeled.",
      "detection_rules": {
        "keywords": [
          "Warrant",
          "Warrants"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    }
  },
  "known_edge_cases": [
    {
      "id": "HPS_CCS_BARE_ISSUER_ROWS",
      "description": "Most rows are bare issuer names without instrument labels. Multiple positions may be distinguished only by trailing numbers.",
      "first_seen_quarter": "2024-06-30",
      "detection_pattern": "Equinox Holdings, Inc.",
      "disposition": "expected"
    },
    {
      "id": "HPS_CCS_PIPE_AFFILIATION_SUFFIX",
      "description": "Later filings append pipe-delimited affiliation suffixes such as '| Non-Affiliated Issuer'. These suffixes are stripped from wrapper position keys.",
      "first_seen_quarter": "2025-12-31",
      "detection_pattern": "\\|\\s*(?:Non-Affiliated|Affiliated)\\s+Issuer",
      "disposition": "expected"
    },
    {
      "id": "HPS_CCS_CASH_FUNDS",
      "description": "Dreyfus, BNY Mellon Treasury, and Goldman Sachs Financial Square government funds are cash or money-market rows outside private-market holdings.",
      "first_seen_quarter": "2025-06-30",
      "detection_pattern": "Dreyfus Government Cash Management",
      "disposition": "expected"
    }
  ],
