  "known_edge_cases": [
    {
      "id": "kkr_fs_affiliated_issuer_pipe_rows",
      "description": "Latest-quarter affiliated rows use an affiliation prefix followed by issuer and instrument text, for example 'Affiliated Issuer | KSC I Aircraft LP, ABF Equity'. The canonical key strips only the affiliation prefix so position matching remains issuer-specific.",
      "first_seen_quarter": "2026-03-31",
      "detection_pattern": "^(?:Affiliated|Non-Affiliated) Issuer \\| ",
      "disposition": "expected"
    },
    {
      "id": "kkr_fs_industry_tranche_only_debt_rows",
      "description": "Many debt positions disclose issuer plus industry/tranche number without an explicit instrument label, e.g. 'Apex Service Partners LLC | Commercial & Professional Services 3'. These rows carry debt economics such as basis spread, principal amount, cost, and fair value.",
      "first_seen_quarter": "2023-06-30",
      "detection_pattern": "(?:\\||,) [A-Za-z&, ]+ [0-9]+$",
      "disposition": "expected"
    }
