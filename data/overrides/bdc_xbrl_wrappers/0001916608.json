    "fallback_family_patterns": [
      {
        "regex": "(?i)^\\s*(?:Cash\\s+Equivalents|Short[- ]term\\s+Investments?|U\\.?S\\.?\\s+Treasury\\s+Bill)\\b",
        "family": "cash"
      },
      {
        "regex": "(?i)^\\s*(?:Total\\s+(?:Investments|Debt\\s+Investments|Equity\\s+Investments|Cash\\s+Equivalents|Short[- ]term\\s+Investments)|Net\\s+Assets|Liabilities\\s+in\\s+Excess\\s+of\\s+Other\\s+Assets|Net\\s+unrealized\\s+depreciation\\s+on\\s+unfunded\\s+commitments)\\b",
        "family": "mixed"
      }
    ],
    "category_marker_re": "(?i)^(?:\\s*,?\\s*)?(?:\\d+(?:\\.\\d+)?%?|[A-Za-z][A-Za-z &,./-]*\\s*(?:,?\\s*%\\s+of\\s+Net\\s+Assets\\s*[-–]?\\s*\\d+(?:\\.\\d+)?\\s*%?|,?\\s*Net\\s+Assets\\s*[-–]?\\s*\\d+(?:\\.\\d+)?\\s*%?)?|Date\\s+Processing\\s+And\\s+Outsourced\\s+Services\\s+Acquisition\\s+Date\\b.*|Processing\\s+And\\s+Outsourced\\s+Services\\s+Acquisition\\s+Date\\b.*)\\s*,?$",
    "category_marker_before_total": true,
    "canonical_strip_re": "(?i)\\s*[^A-Za-z0-9\\s/,]\\s*\\d+(?:\\.\\d+)?%.*?(?=\\s+Maturity(?:\\s+Date)?\\b)|\\s+(?:%\\s+of\\s+)?Net\\s+Assets\\s*[-–]?\\s*\\d+(?:\\.\\d+)?%"
  },
  "identifier_format": {
    "delimiter": " ",
    "field_order": [
      "asset_class",
      "industry",
      "issuer_name",
      "acquisition_date",
      "instrument_description",
      "rate",
      "net_assets",
      "maturity"
    ],
    "alternate_delimiters": [
      ", ",
      " - "
    ]
  },
  "staging": {
    "strategy": "hierarchy_extract",
    "hierarchy_issuer_re": "(?i)^\\s*(?:Debt|Equity)\\s+Investments?\\s*,?\\s+(?:(?:MSD_INDUSTRY_LABELS),?\\s+)+(.+?),?\\s+Acquisition\\s+Date\\s*-?\\s+",
    "hierarchy_instrument_re": "(?i)\\bAcquisition\\s+Date\\s*-?\\s+(?:\\d{1,2}/\\d{1,2}/\\d{2,4}(?:\\s*&\\s*\\d{1,2}/\\d{1,2}/\\d{2,4})?)\\s+(?:Investment\\s+)?(.+?)(?:\\s*[^A-Za-z0-9\\s/,]\\s*\\d|\\s+%\\s+of\\s+Net\\s+Assets\\b|\\s+Net\\s+Assets\\b|\\s+Maturity\\s+Date?\\b|$)",
    "hierarchy_condition_extra": "regexp_matches(_clean, '(?i)^\\s*(?:Debt|Equity)\\s+Investments?\\s*,?\\s+.*\\bAcquisition\\s+Date\\s*-?\\s+.*\\b(?:Term\\s+Loan|Delayed\\s+Draw|Revolver|Warrants?|Common\\s+(?:Units|Stock))\\b') AND NOT regexp_matches(_clean, '(?i)^\\s*Debt\\s+Investment\\s+(?:Date\\s+Processing\\s+And\\s+Outsourced\\s+Services|Processing\\s+And\\s+Outsourced\\s+Services)\\s+Acquisition\\s+Date\\b')",
    "extra_industry_labels": [
