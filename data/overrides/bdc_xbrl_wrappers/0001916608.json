  "archetypes": {
    "debt": {
      "description": "TCW Star debt positions including term loans, delayed draw term loans, and revolvers.",
      "detection_rules": {
        "keywords": [
          "Term Loan",
          "Delayed Draw",
          "Revolver",
          "SOFR",
          "Maturity"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000
        },
        "interest_rate": {
          "type": "numeric_range",
          "constraint": "optional",
          "min": 0.0,
          "max": 1.0
        }
      }
    },
    "equity": {
      "description": "TCW Star common stock, common unit, and equity-linked warrant positions.",
      "detection_rules": {
        "keywords": [
          "Common Stock",
          "Common Units",
          "Warrant",
          "Warrants"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000
        }
      }
    }
  },
  "known_edge_cases": [
    {
      "id": "TCW_STAR_SINGULAR_DEBT_INVESTMENT_LABEL",
      "description": "Early and current XBRL labels use singular Debt Investment and Equity Investment prefixes, while related TCW wrappers use plural labels.",
      "first_seen_quarter": "2023-03-31",
      "detection_pattern": "Debt Investment <industry> <issuer> Acquisition Date",
      "disposition": "expected"
    },
    {
      "id": "TCW_STAR_INDUSTRY_SUBTOTALS",
      "description": "Debt Investment and Equity Investment rows ending with percent-of-net-assets text are industry subtotals, not position-level holdings.",
      "first_seen_quarter": "2023-03-31",
      "detection_pattern": "Debt Investment <industry> % of Net Assets",
      "disposition": "expected"
    },
    {
      "id": "TCW_STAR_MALFORMED_DATA_PROCESSING_ROW",
      "description": "Several 2023 rows disclose Data/Date Processing and Outsourced Services plus acquisition and loan terms without an issuer name; these are not promoted to position leaves without source evidence.",
      "first_seen_quarter": "2023-03-31",
      "detection_pattern": "Debt Investment Date Processing And Outsourced Services Acquisition Date",
      "disposition": "warn"
    }
  ],
