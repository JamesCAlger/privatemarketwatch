  "known_edge_cases": [
    {
      "id": "blue_owl_tech_pipe_and_comma_formats",
      "description": "Latest-quarter identifiers use pipe-delimited issuer and instrument text, while older identifiers commonly use comma-delimited issuer and instrument text.",
