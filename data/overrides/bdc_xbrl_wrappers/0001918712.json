{
  "schema_version": "bdc-xbrl-wrapper.v3",
  "cik": "0001918712",
  "entity_name": "Ares Strategic Income Fund",
  "version": 1,
  "source": "bdc_xbrl",
  "dispatch": {
    "rule_prefix": "ARES_STRATEGIC_INCOME",
    "issuer_name_strip_re": "(?<!^Cannon Bridge Designated Activity Company)\\s*,\\s*(?:Private asset[- ]backed investment|(?:Commercial|Residential) mortgage-backed security)(?:\\s+\\d{1,2})?$",
    "issuer_name_strip_to_instrument": true,
    "shares_pow10_normalise": false,
    "prefix_rules": {},
    "flat_schedule": true,
    "leaf_markers_by_family": {},
    "aggregate_markers": [
      "sub-total",
      "subtotal",
      "total investments",
      "total debt investments",
      "total equity investments"
    ],
    "non_private_markers": [
      "cash",
      "money market",
      "financial square",
      "government institutional",
      "u.s. treasury",
      "us treasury"
    ],
    "fallback_family_patterns": [
      {
        "regex": "(?i)first lien|second lien|senior secured|senior subordinated|subordinated|unitranche|term loan|revolving|delayed draw",
        "family": "debt"
      },
      {
        "regex": "(?i)common stock|common equity|common units|preferred stock|preferred equity|preferred shares|preferred units|senior preferred|partnership interest|LLC interest|equity interest|equity co-invest",
        "family": "equity"
      },
      {
        "regex": "(?i)warrant",
        "family": "warrant"
      },
      {
        "regex": "(?i)collateralized loan obligation|collaterized loan obligation|CLO",
        "family": "clo"
      }
    ]
  },
  "identifier_format": {
    "delimiter": ", ",
    "field_order": [
      "issuer_name",
      "instrument_description",
      "reference_rate",
      "interest_rate",
      "maturity_date"
    ],
    "alternate_delimiters": [
      " | "
    ]
  },
  "staging": {
    "strategy": "hierarchy_extract",
    "hierarchy_issuer_re": "^(.+?)(?:\\s*\\|\\s*[^|]+?(?:\\s*\\|\\s*[\\d.]+\\s*%)?|,\\s*[^,|]+)$",
    "hierarchy_instrument_re": "(?:^[^|]*\\|\\s*|^[^|]*,\\s*)([^|]+?)(?:\\s*\\|\\s*[\\d.]+\\s*%)?$",
    "hierarchy_condition_extra": "regexp_matches(_clean, '(?i)(?:,|\\|)\\s*[^,|]*(?:loan|notes?|units?|stock|shares?|interests?|warrants?|equity|certificates?|bonds?|debentures?|membership|preferred|common|partnership|participation rights)[^,|]*(?:\\s*\\|\\s*[\\d.]+\\s*%)?$')"
  },
  "archetypes": {
    "senior_secured_debt": {
      "description": "First lien, second lien, unitranche, and other senior secured term loans and revolvers",
      "detection_rules": {
        "keywords": [
          "First lien senior secured loan",
          "First lien senior secured delayed draw term loan",
          "First lien senior secured revolving loan",
          "Second lien senior secured loan",
          "Senior secured loan",
          "Senior subordinated loan",
          "Subordinated loan",
          "Unitranche first lien loan",
          "Delayed draw term loan",
          "Revolving credit facility",
          "Term loan"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "interest_rate": {
          "type": "numeric_range",
          "constraint": "optional",
          "min": 1.0,
          "max": 30.0
        },
        "basis_spread": {
          "type": "numeric_range",
          "constraint": "optional",
          "min": 1.0,
          "max": 15.0
        },
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -100000000,
          "max": 100000000000
        },
        "shares_held": {
          "type": "presence",
          "constraint": "optional"
        }
      }
    },
    "equity": {
      "description": "Common stock, preferred shares, partnership interests, LLC interests, and fund vehicles",
      "detection_rules": {
        "keywords": [
          "Common stock",
          "Preferred shares",
          "Preferred stock",
          "Preferred equity",
          "Partnership interest",
          "Limited partnership interest",
          "LLC interest",
          "LLC membership interest",
          "Class A units",
          "Class B units",
          "Equity interest",
          "Equity co-invest"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "shares_held": {
          "type": "presence",
          "constraint": "optional"
        },
        "interest_rate": {
          "type": "numeric_range",
          "constraint": "optional",
          "min": 1.0,
          "max": 30.0
        },
        "basis_spread": {
          "type": "presence",
          "constraint": "forbidden"
        },
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -100000000,
          "max": 100000000000
        }
      }
    },
    "clo": {
      "description": "Collateralized loan obligation tranches and structured credit",
      "detection_rules": {
        "keywords": [
          "Collateralized loan obligation",
          "Collaterized loan obligation",
          "CLO"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "interest_rate": {
          "type": "numeric_range",
          "constraint": "optional",
          "min": 1.0,
          "max": 30.0
        },
        "basis_spread": {
          "type": "numeric_range",
          "constraint": "optional",
          "min": 1.0,
          "max": 15.0
        },
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -100000000,
          "max": 100000000000
        }
      }
    },
    "warrant": {
      "description": "Warrants and options on equity",
      "detection_rules": {
        "keywords": [
          "Warrant",
          "Warrants"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "interest_rate": {
          "type": "presence",
          "constraint": "forbidden"
        },
        "basis_spread": {
          "type": "presence",
          "constraint": "forbidden"
        },
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -100000000,
          "max": 100000000000
        }
      }
    }
  },
  "invariants": {
    "fv_reconciliation": {
      "source_field": "investments_at_fair_value",
      "tolerance_pct": 0.05,
      "tolerance_abs": 5000000
    },
    "position_count_qoq": {
      "max_increase_pct": 2.0,
      "max_decrease_pct": 0.5
