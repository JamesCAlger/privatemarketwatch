  "known_edge_cases": [
    {
      "id": "owlrock_pipe_format_change",
      "description": "Identifiers switched from comma-delimited (Issuer, Instrument) to pipe-delimited (Issuer | Instrument | Affiliation) starting Q4 2025. The canonical_strip_re removes the pipe-appended affiliation label.",
      "first_seen_quarter": "2025-12-31",
      "detection_pattern": " \\| ",
      "disposition": "expected"
    },
    {
      "id": "owlrock_no_affiliated_typo",
      "description": "Typo variant 'No-Affiliated Issuer' instead of 'Non-Affiliated Issuer' appears in some pipe-delimited identifiers.",
      "first_seen_quarter": "2025-12-31",
      "detection_pattern": "No-Affiliated Issuer",
      "disposition": "expected"
    },
    {
      "id": "owlrock_footnote_suffix",
      "description": "Affiliated/controlled entity positions have (c) or (d) footnote suffixes directly on the entity name, marking affiliation status.",
      "first_seen_quarter": "2023-03-31",
      "detection_pattern": "\\([cd]\\)\\s*$",
      "disposition": "expected"
    },
    {
      "id": "owlrock_abf_bf_category_headers",
      "description": "Category header rows like 'ABF - Leasing', 'ABF - Specialty finance', 'BF - Commercial Real Estate' with no FV/rate/maturity. Section headers for specialty finance sub-categories.",
      "first_seen_quarter": "2025-12-31",
      "detection_pattern": "^(?:ABF|BF) - ",
      "disposition": "expected"
    },
    {
      "id": "owlrock_bare_affiliated_entities",
      "description": "Affiliated fund vehicles (LSI Financing, Fifth Season Investments, Blue Owl Credit SLF, OCIC SLF, BOCSO) appear as bare entity names without instrument type suffix. These are legitimate specialty finance positions.",
      "first_seen_quarter": "2023-03-31",
      "detection_pattern": "(?i)^(?:LSI Financing|Fifth Season|Blue Owl Credit SLF|Blue Owl Cross-Strategy|OCIC SLF|OWL-HP FINANCE|Wingspire Capital)",
      "disposition": "expected"
    },
    {
      "id": "owlrock_numeric_tranche_suffix",
      "description": "Numeric suffixes (1, 2) distinguish different loan tranches to the same borrower (e.g., 'First lien senior secured loan 1').",
      "first_seen_quarter": "2023-03-31",
      "detection_pattern": "loan \\d+$",
      "disposition": "expected"
    },
    {
      "id": "owlrock_commitment_subtotals",
      "description": "Commitment subtotal rows (Total Portfolio Company Commitments, Total non-controlled/non-affiliated - debt commitments) with negative FV representing unfunded commitment obligations.",
      "first_seen_quarter": "2024-12-31",
      "detection_pattern": "^Total .* commitments?$",
      "disposition": "expected"
    },
    {
      "id": "owlrock_bsl_bare_names",
      "description": "Broadly syndicated loan positions in Q3 2023 through Q1 2024 appear as bare company names without instrument type suffix (e.g., 'Berlin Packaging L.L.C.', 'Hub International'). These are legitimate BSL positions but cannot be classified by dispatch without an instrument keyword. Causes 27% unclassified rate in affected quarters.",
      "first_seen_quarter": "2023-09-30",
      "detection_pattern": "^[A-Z0-9]",
      "disposition": "expected"
    }
  ],
