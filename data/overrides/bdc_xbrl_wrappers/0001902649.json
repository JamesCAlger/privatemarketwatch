        "regex": "(?i)^\\s*(?:cash\\s+and\\s+cash\\s+equivalents|total\\s+cash\\s+and\\s+investments|cash\\s+and\\s+investments|total\\s+investments|investments\\s+-\\s+|total\\s+debt\\s+investments|total\\s+equity\\s+securities|total\\s+equity\\s+investments)\\b",
        "family": "mixed"
      },
      {
        "regex": "(?i)^\\s*Debt\\s+Investments\\b|\\b(?:first\\s+lien|second\\s+lien|senior\\s+secured|subordinated|unsecured\\s+note|term\\s+loan|delayed\\s+draw|revolver|revolving|SOFR|LIBOR|EURIBOR|maturity(?:\\s+date)?|total\\s+coupon)\\b",
        "family": "debt"
      },
      {
        "regex": "(?i)^\\s*(?:Equity\\s+Securities\\s*|Equity\\s+Investments\\b)|\\b(?:common\\s+stock|preferred\\s+stock|common\\s+shares|preferred\\s+shares|common\\s+units|preferred\\s+units|equity\\s+securities)\\b",
        "family": "equity"
      },
      {
        "regex": "(?i)\\bwarrants?\\b",
        "family": "warrant"
      }
    ],
    "canonical_strip_re": "(?i)^\\s*(?:Debt\\s+Investments|Equity\\s+Securities|Equity\\s+Investments)\\s+|\\s+Ref\\s+.*$|\\s+Reference\\s+Rate\\s+.*$|\\s+Interest\\s+Rate\\s+\\d+\\.?\\d*%|\\s+Maturity(?:\\s+Date)?\\s+\\d{1,2}/\\d{1,2}/\\d{2,4}\\b"
  },
  "staging": {
    "strategy": "hierarchy_extract",
    "hierarchy_issuer_re": "(?i)^\\s*(?:Debt\\s+Investments|Equity\\s+Securities|Equity\\s+Investments)\\s*(?:(?:MSD_INDUSTRY_LABELS)\\s+)?(.+?)\\s+(?:(?:Instrument|Investment|Instument)\\s+)?(?:[A-Z]\\s+Ref|First|Second|Subordinated|Unsecured|Senior|Delayed|Revolver|Revolving|Term\\s+Loan|Common|Preferred|Warrants?|Class|Ref)\\b",
    "hierarchy_instrument_re": "(?i)\\s+(?:(?:Instrument|Investment|Instument)\\s+)?((?:[A-Z]\\s+Ref|First|Second|Subordinated|Unsecured|Senior|Delayed|Revolver|Revolving|Term\\s+Loan|Common|Preferred|Warrants?|Class|Ref)\\b.+?)(?:\\s+(?:Ref|Reference\\s+Rate|Interest\\s+Rate|SOFR|LIBOR|EURIBOR|Prime|Floor|Spread|Total\\s+Coupon|Maturity(?:\\s+Date)?)\\b|$)",
    "hierarchy_trailing_re": "(?i)\\s+(Maturity(?:\\s+Date)?\\s+\\d{1,2}/\\d{1,2}/\\d{2,4}\\b(?:\\s+(?:One|Two|Three|Four))?)",
    "hierarchy_condition_extra": "regexp_matches(_clean, '(?i)^\\s*(?:Debt\\s+Investments\\b|Equity\\s+Securities\\s*|Equity\\s+Investments\\b)') AND (regexp_matches(_clean, '(?i)\\b(?:Instrument|Investment|Instument)\\b') OR (regexp_matches(_clean, '(?i)\\b(?:Inc\\.?|LLC\\d?|Corp\\.?|Corporation|L\\.L\\.C\\.|L\\.P\\.|Ltd\\.?|Limited|Holdings?|Group|Bidco|Buyer|Parent|Borrower|SAS|B\\.V\\.|SE\\b|LP\\b)') AND regexp_matches(_clean, '(?i)\\b(?:First|Second|Subordinated|Unsecured|Senior|Delayed|Revolver|Revolving|Term\\s+Loan|Common|Preferred|Warrants?|Class|[A-Z]\\s+Ref)\\b')))",
