  "known_edge_cases": [
    {
      "id": "flat_identifier_interest_rate_facts",
      "description": "InvestmentIdentifierAxis values are flat property, loan, or securitization names; position-level debt evidence is carried in source interest-rate/principal/cost/fair-value facts rather than instrument words in the identifier.",
