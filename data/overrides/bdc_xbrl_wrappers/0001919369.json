  "known_edge_cases": [
    {
      "id": "legacy_bare_issuer_rows",
      "description": "Earlier quarters use bare issuer-name rows without rate or maturity text. Legal-form single-issuer rows and recurring single issuer names with fair value are classified as position leaves; comma-and issuer lists without fair value are not matched by that fallback.",
      "first_seen_quarter": "2023-12-31",
      "detection_pattern": "^[Issuer legal name]$",
      "disposition": "expected"
    },
    {
      "id": "rate_and_spread_are_key_volatility",
      "description": "Displayed reference spread and current interest rate can drift quarter to quarter. Wrapper keys strip those values while preserving asset family, issuer, and maturity date.",
      "first_seen_quarter": "2025-06-30",
      "detection_pattern": "Reference Rate and Spread ... Interest Rate ... Maturity Date",
      "disposition": "expected"
    }
