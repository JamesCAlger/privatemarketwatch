      {
        "regex": "(?i)^\\s*Investments\\s+(?:[-\\u2013]\\s*)?(?:non-controlled/(?:non-)?affiliated\\s+)?First[-\\s]Lien\\s+Debt\\b.*\\b(?:Reference\\s+Rate\\s+and\\s+Spread|Interest\\s+Rate|Maturity\\s+Date)\\b",
        "family": "debt"
      },
      {
        "regex": "(?i)^\\s*Investments\\s+(?:[-\\u2013]\\s*)?(?:non-controlled/(?:non-)?affiliated\\s+)?(?:Preferred\\s+Equity|Other\\s+Equity)\\b.*\\b(?:Interest\\s+Rate|Maturity\\s+Date)\\b",
        "family": "equity"
      },
      {
        "regex": "(?i)^\\s*(?:Acronis\\s+International|McKissock\\s+Investment\\s+Holdings|SumUp\\s+Holdings\\s+Midco\\s+S\\..+\\s+r\\.l)\\s*,?\\s*$",
        "family": "debt"
      },
      {
        "regex": "(?i)^(?!.*\\s+and\\s+)(?!.*,[^,]*,)(?=.*\\b(?:LLC|Inc\\.?|Corporation|Corp\\.?|L\\.P\\.?|LP|Ltd\\.?|B\\.V\\.?)\\b)[A-Za-z0-9&.,'() /-]+$",
        "family": "debt"
      }
    ],
    "category_marker_re": "(?i)^\\s*(?:Total\\s+(?:First[-\\s]Lien\\s+Debt|Preferred\\s+Equity|Other\\s+Equity|Investments(?:\\s*-\\s*non-controlled/non-affiliated)?)|Subtotal|Sub-Total|(?:Automobiles\\s+&\\s+Automobile\\s+Parts|Architecture,\\s+Construction\\s+&\\s+Engineering|Data\\s+&\\s+Analytics|Diversified\\s+Business\\s+Services|Diversified\\s+Consumer\\s+Services|Diversified\\s+Financial\\s+Institutions\\s+&\\s+Services|Diversified\\s+Software|Education|Financials|Government\\s+&\\s+Public\\s+Service|Government,\\s+Risk\\s+&\\s+Compliance|Healthcare\\s+IT\\s+&\\s+Technology|Hotels,\\s+Restaurants\\s+&\\s+Leisure|IT\\s+Security|IT\\s+Services\\s+&\\s+IT\\s+Systems\\s+Management\\s*\\(Ex-Security\\)?|Infrastructure\\s+Software\\s+&\\s+DevOps|Insurance|Media,\\s+Entertainment\\s+&\\s+Publishing|Real\\s+Estate|Telecom\\s+Services\\s+&\\s+IT\\s+Hardware|Transportation,\\s+Logistics\\s+&\\s+Supply\\s+Chain|Utilities\\s+&\\s+Utility\\s+Equipment))\\s*$",
    "canonical_strip_re": "(?i)^\\s*Investments\\s+(?:[-\\u2013]\\s*)?(?:non-controlled/(?:non-)?affiliated\\s+)?|\\s+Reference\\s+Rate\\s+and\\s+Spread\\s+.*?(?=\\s+Interest\\s+Rate|\\s+Maturity\\s+Date|$)|\\s+Interest\\s+Rate\\s+\\d+(?:\\.\\d+)?%\\s*(?=Maturity\\s+Date|\\s+Maturity\\s+Date|$)",
