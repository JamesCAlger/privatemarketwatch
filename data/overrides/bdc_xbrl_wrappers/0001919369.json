    "hierarchy_instrument_re": "(?i)^\\s*Investments\\s+(?:–\\s*)?(?:non-controlled/(?:non-)?affiliated\\s+)?((?:First[-\\s]Lien\\s+Debt|Preferred\\s+Equity|Other\\s+Equity))\\s+",
    "hierarchy_condition_extra": "regexp_matches(_clean, '(?i)^\\s*Investments\\s+(?:–\\s*)?(?:non-controlled/(?:non-)?affiliated\\s+)?(?:First[-\\s]Lien\\s+Debt|Preferred\\s+Equity|Other\\s+Equity)\\s+') AND regexp_matches(_clean, '(?i)\\b(?:Reference\\s+Rate\\s+and\\s+Spread|Interest\\s+Rate|Maturity\\s+Date)\\b')"
