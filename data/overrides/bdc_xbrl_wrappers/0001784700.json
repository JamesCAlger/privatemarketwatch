    "hierarchy_condition_extra": "regexp_matches(_clean, '(?i)^\\s*(?:(?:Non-Controlled/Non-AffiliateNon-Controlled/Non-Affiliated|Non-Controlled/Non-Affiliated|Controlled\\s+Non-Affiliated|Controlled/Non-Affiliated)\\s+Investments,\\s+Senior\\s+Secured\\s+First\\s+Lien\\s+Loans,\\s+|Non-Controlled/Non-Affiliated\\s+Investments,\\s+Equity,\\s+|Controlled\\s+Investments,\\s+)') AND regexp_matches(_clean, '(?i)\\bType\\s+of\\s+Investment\\b')",
