      "detection_pattern": "Maturity <date> (One|Two)",
      "disposition": "expected"
    },
    {
      "id": "VARAGON_THOUSANDS_AT_DECIMALS_ZERO",
      "description": "The schedule prints thousands. In the listed filings part of the position facts carry the printed thousands figure at decimals 0 beside -3 siblings (10-Q 2023-03-31: every current-period principal fact, e.g. A&R Logistics 5010 against printed '05/03/25 5,010 $ 4,973 $ 4,872'; Del Real fair value 3478; later filings single rows: Graffiti, EIS, Oliver revolver, Horizon Freight, Cold Spring, JTM, Alert SRC, the money market fund par 2025-09-30). source_encodings.thousands_scale_filings reads decimals-0 cost, fair value and principal as thousands there. Equity unit counts tagged as principal at decimals 0 (2023-03-31, 2023-09-30: '500,000' units) are counts; only KLC Fund 1-C1 publishes that principal and it is withdrawn by context correction.",
      "first_seen_quarter": "2023-03-31",
      "detection_pattern": "decimals=\"0\" beside decimals=\"-3\" on one context",
      "disposition": "expected"
    }
