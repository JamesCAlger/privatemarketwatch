  "archetypes": {
    "debt": {
      "description": "Senior secured first lien debt positions with issuer, type of investment, spread, coupon, acquisition date, and maturity encoded in comma hierarchy strings.",
      "detection_rules": {
        "keywords": [
          "Term Loan",
          "Delayed Draw Term Loan",
          "Revolver",
          "Reference Rate and Spread",
          "SOFR",
          "PRIME"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        },
        "interest_rate": {
          "type": "numeric_range",
          "constraint": "optional",
          "min": 0.0,
          "max": 1.0
        }
      }
    },
    "equity": {
      "description": "Equity positions including class units, preferred stock units, limited partnership units, and equity co-investments.",
      "detection_rules": {
        "keywords": [
          "Class A Units",
          "Class A-1 Units",
          "Class B Units",
          "Class C Units",
          "Class D Units",
          "Common Units",
          "Equity Co-Invest",
          "Limited Partnership Units",
          "Preferred Stock",
          "Series A Interest"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    },
    "mixed": {
      "description": "Controlled investment and subtotal/total hierarchy rows used for source reconciliation diagnostics.",
      "detection_rules": {
        "keywords": [
          "Controlled Investments",
          "Subtotal",
          "Total Investments"
        ],
        "keyword_mode": "any"
      },
      "field_signatures": {
        "fair_value": {
          "type": "numeric_range",
          "constraint": "required",
          "min": -1000000000,
          "max": 1000000000000
        }
      }
    }
  },
  "known_edge_cases": [
    {
      "id": "VARAGON_COMMA_HIERARCHY",
      "description": "Position rows use comma-delimited affiliation, asset class, industry, company, type of investment, rate, acquisition date, and maturity segments.",
      "first_seen_quarter": "2023-03-31",
      "detection_pattern": "Company <issuer>, Type of Investment <instrument>",
      "disposition": "expected"
    },
    {
      "id": "VARAGON_COMPARATIVE_TOTALS",
      "description": "Quarterly source rows can include current and comparative Total Investments labels; these are non-position totals and should remain excluded from position-level holdings.",
      "first_seen_quarter": "2023-03-31",
      "detection_pattern": "Total Investments, <Month> <Day>, <Year>",
      "disposition": "expected"
    },
    {
      "id": "VARAGON_LOT_SUFFIXES",
      "description": "Some tranche rows append One or Two after maturity to distinguish lots; the wrapper preserves those suffixes in position keys.",
      "first_seen_quarter": "2024-03-31",
      "detection_pattern": "Maturity <date> (One|Two)",
      "disposition": "expected"
    }
