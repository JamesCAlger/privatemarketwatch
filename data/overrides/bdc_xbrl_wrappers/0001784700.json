    "category_marker_before_total": true,
    "canonical_strip_re": "(?i)^\\s*(?:(?:Non-Controlled/Non-AffiliateNon-Controlled/Non-Affiliated|Non-Controlled/Non-Affiliated|Controlled\\s+Non-Affiliated|Controlled/Non-Affiliated)\\s+Investments,\\s+Senior\\s+Secured\\s+First\\s+Lien\\s+Loans,\\s+|Non-Controlled/Non-Affiliated\\s+Investments,\\s+Equity,\\s+|Controlled\\s+Investments,\\s+)(?:Industry(?:\\s+[^,]*)?,\\s+)?(?:Company\\s+)?|,?\\s*Industry\\s+[^,]+(?=,?\\s+Type\\s+of\\s+Investment\\b)|,?\\s*Reference\\s+Rate\\s+and\\s+Spread\\s+.*?(?=,?\\s+(?:Interest\\s+Rate|Acquisition\\s+Date|Maturity)\\b|$)|,?\\s*Interest\\s+Rate\\s+\\d+(?:\\.\\d+)?%?|,?\\s*Acquisition\\s+Date\\s+\\d{1,2}/\\d{1,2}/\\d{2,4}"
