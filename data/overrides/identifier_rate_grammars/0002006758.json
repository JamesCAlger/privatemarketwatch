{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0002006758",
  "applies_to": {
    "regime": "flattened",
    "signature": "SECDEBT RATE MAT"
  },
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "(?:Interest Rate\\s+)?(CORRA|S|E)\\+\\d+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR",
        "E": "EURIBOR",
        "CORRA": "CORRA"
      }
    },
    {
      "field": "basis_spread",
      "regex": "(?:CORRA|S|E)\\+(\\d+)",
      "group": 1,
      "type": "bps",
      "map": {}
    },
    {
      "field": "pik_rate",
      "regex": "(?:Cash plus\\s+)?(\\d+(?:\\.\\d+)?)%\\s+PIK",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate_floor",
      "regex": "(\\d+(?:\\.\\d+)?)%\\s+Floor",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "[Mm]aturity Date\\s+(\\d{1,2}/\\d{1,2}/(?:\\d{4}|\\d{2})\\b)",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "required_fields": [
    "maturity_date"
  ],
  "pik_convention": "additive",
  "derivations": [
    {
      "field": "coupon_type",
      "kind": "floating_iff_reference"
    }
  ],
  "invariants": [
    {
      "name": "maturity_matches_structured_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ]
}
