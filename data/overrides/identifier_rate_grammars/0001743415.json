{
  "version": "agentA-rate-grammar.v1",
  "cik": "0001743415",
  "entity_name": "SCP Private Credit Income BDC LLC",
  "report_date": "2026-03-31",
  "status": "PROPOSED",
  "applies_to": {"regime": "flattened", "signature": "SECDEBT"},
  "available_identifier_datapoints": ["instrument_type", "issuer", "industry", "reference_rate_type", "basis_spread", "interest_rate_floor", "interest_rate", "acquisition_date", "maturity_date", "section_percent_of_net_assets"],
  "unsupported_identifier_datapoints": ["pik_rate", "cash_interest_rate", "all_in_interest_rate_breakout"],
  "pik_convention": null,
  "required_fields": ["interest_rate"],
  "extractors": [
    {"field": "reference_rate_type", "regex": "(?:Spread above Index\\s+|\\|\\s*)([A-Z])\\+\\d+(?:\\.\\d+)?", "group": 1, "type": "ref_code", "map": {"S": "SOFR", "P": "PRIME"}},
    {"field": "basis_spread", "regex": "(?:Spread above Index\\s+|\\|\\s*)[A-Z]\\+(\\d+(?:\\.\\d+)?)", "group": 1, "type": "bps", "map": {}},
    {"field": "interest_rate", "regex": "(?:Interest Rate\\s+|\\|\\s*[A-Z]\\+\\d+(?:\\.\\d+)?\\s*\\|\\s*\\d+(?:\\.\\d+)?%?\\s*\\|\\s*)(\\d+(?:\\.\\d+)?)%?", "group": 1, "type": "pct", "map": {}},
    {"field": "interest_rate", "regex": "Bank Debt/Senior Secured Loans\\s*\\|\\s*[^|]+\\s*\\|\\s*[^|]+\\s*\\|\\s*(\\d+(?:\\.\\d+)?)%?\\s*\\|\\s*\\d{1,2}/\\d{1,2}/\\d{4}\\s*\\|", "group": 1, "type": "pct", "map": {}},
    {"field": "maturity_date", "regex": "(?:Maturity Date\\s+|\\|\\s*\\d{1,2}/\\d{1,2}/\\d{4}\\s*\\|\\s*)(\\d{1,2}/\\d{1,2}/\\d{4})", "group": 1, "type": "date_mdy", "map": {}}
  ],
  "invariants": [
    {"name": "spread_implies_reference_rate", "kind": "implication", "if_present": "basis_spread", "then_present": "reference_rate_type"},
    {"name": "full_maturity_matches_twin", "kind": "date_agree", "parsed": "maturity_date", "twin": "maturity_date"}
  ],
  "notes": [
    "One grammar covers prose and pipe-delimited identifier eras.",
    "Optional floor and PIK-related fields are not required. Maturity parsing is limited to full M/D/Y identifiers; newer M/Y text remains inventoried but is not forced through date_mdy.",
    "Some bundle twins are visibly mis-binned (including spread/PIK examples), so the grammar follows identifier text and uses conservative invariants."
  ]
}
