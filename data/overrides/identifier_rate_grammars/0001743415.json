{
  "version": "agentA-rate-grammar.v1",
  "cik": "0001743415",
  "entity_name": "SCP Private Credit Income BDC LLC",
  "report_date": "2025-12-31",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "SECDEBT"
  },
  "available_identifier_datapoints": [
    "instrument_type",
    "issuer",
    "industry",
    "reference_rate_type",
    "basis_spread",
    "interest_rate_floor",
    "interest_rate",
    "acquisition_date",
    "maturity_date",
    "section_percent_of_net_assets"
  ],
  "unsupported_identifier_datapoints": [
    "pik_rate",
    "cash_interest_rate",
    "all_in_interest_rate_breakout"
  ],
  "pik_convention": null,
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "interest_rate"
  ],
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "(?:(?:Spread above Index\\s+)|(?:\\|\\s*))([A-Z])\\+\\d+(?:\\.\\d+)?",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "(?:(?:Spread above Index\\s+)|(?:\\|\\s*))[A-Z]\\+(\\d+(?:\\.\\d+)?)",
      "group": 1,
      "type": "bps",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "(?:(?:Interest Rate\\s+)|(?:\\|\\s*[A-Z]\\+\\d+(?:\\.\\d+)?\\s*\\|\\s*\\d+(?:\\.\\d+)?%?\\s*\\|\\s*))(\\d+(?:\\.\\d+)?)%?",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "(?:(?:Maturity Date\\s+)|(?:\\|\\s*\\d{1,2}/\\d{1,2}/\\d{4}\\s*\\|\\s*))(\\d{1,2}/\\d{1,2}/\\d{4})",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "invariants": [
    {
      "name": "interest_rate_matches_structured_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "basis_spread_matches_structured_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    },
    {
      "name": "maturity_date_matches_structured_twin_when_full_date_present",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "spread_implies_reference_rate",
      "kind": "implication",
      "if_present": "basis_spread",
      "then_present": "reference_rate_type"
    }
  ],
  "notes": [
    "The bundle contains two identifier eras: prose identifiers with 'Spread above Index S+...' and 'Interest Rate ...%', and older pipe-delimited identifiers with '| S+... | floor | rate | acquisition | maturity'.",
    "PIK is not embedded in sampled identifiers and is not proposed as an extractor or required field.",
    "Maturity dates are extracted only when the identifier includes a full M/D/Y date; newer M/Y maturity strings are intentionally not parsed by the date_mdy extractor."
  ]
}
