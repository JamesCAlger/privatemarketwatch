{
  "version": "agentA-rate-grammar.v1",
  "cik": "0001743415",
  "entity_name": "SCP Private Credit Income BDC LLC",
  "report_date": "2026-03-31",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "SECDEBT"
  },
  "available_identifier_datapoints": [
    "instrument_type",
    "issuer",
    "industry",
    "reference_rate_type",
    "basis_spread",
    "interest_rate_floor",
    "interest_rate",
    "acquisition_date",
    "maturity_date",
    "section_percent_of_net_assets"
  ],
  "unsupported_identifier_datapoints": [
    "pik_rate",
    "cash_interest_rate",
    "all_in_interest_rate_breakout"
  ],
  "pik_convention": null,
  "required_fields": [
    "interest_rate"
  ],
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "(?:Spread above Index\\s+|\\|\\s*)([A-Z])\\+\\d+(?:\\.\\d+)?",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR",
        "P": "PRIME"
      }
    },
    {
      "field": "basis_spread",
      "regex": "(?:Spread above Index\\s+|\\|\\s*)[A-Z]\\+(\\d+(?:\\.\\d+)?)",
      "group": 1,
      "type": "bps",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "(?:Interest Rate\\s+|\\|\\s*[A-Z]\\+\\d+(?:\\.\\d+)?\\s*\\|\\s*\\d+(?:\\.\\d+)?%?\\s*\\|\\s*)(\\d+(?:\\.\\d+)?)%?",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "Bank Debt/Senior Secured Loans\\s*\\|\\s*[^|]+\\s*\\|\\s*[^|]+\\s*\\|\\s*(\\d+(?:\\.\\d+)?)%?\\s*\\|\\s*\\d{1,2}/\\d{1,2}/\\d{4}\\s*\\|",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "(?:Maturity Date\\s+|\\|\\s*\\d{1,2}/\\d{1,2}/\\d{4}\\s*\\|\\s*)(\\d{1,2}/\\d{1,2}/\\d{4})",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "invariants": [
    {
      "name": "spread_implies_reference_rate",
      "kind": "implication",
      "if_present": "basis_spread",
      "then_present": "reference_rate_type"
    },
    {
      "name": "maturity_date_matches_structured_twin_when_full_date_present",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ],
  "notes": [
    "SECDEBT identifiers span prose and pipe-delimited eras. Prose rows carry 'Spread above Index S+...' or 'P+...', optional Floor text, 'Interest Rate ...%', acquisition date, and maturity date. Older pipe rows carry instrument, issuer, industry, optional reference/spread, floor, rate, acquisition date, and maturity date.",
    "The extractor set intentionally does not parse interest_rate_floor or pik_rate because the task contract excludes optional fields from required_fields and sampled identifiers do not provide a stable PIK rate value.",
    "Maturity extraction is limited to full M/D/Y strings accepted by date_mdy; newer M/Y maturity strings are identified as available text but left unparsed by this rate grammar.",
    "Twin pct agreement invariants are not proposed because at least one sampled older row has a structured interest_rate twin inconsistent with the identifier text."
  ]
}
