  ],
  "pik_convention": "inclusive",
  "extractors": [
    {"field": "reference_rate_type", "regex": "(?:Interest\\s+(?:Term\\s+)?|\\bTerm\\s+)([A-Za-z]+)\\s*\\+\\s*[0-9]", "group": 1, "type": "ref_code", "map": {"S": "SOFR", "SF": "SOFR", "SOFR": "SOFR", "SN": "SONIA", "P": "PRIME", "PRIME": "PRIME", "E": "EURIBOR", "EURIBOR": "EURIBOR", "SR": "SARON", "L": "LIBOR", "LIBOR": "LIBOR", "C": "CDOR", "B": "BBSW"}},
    {"field": "basis_spread", "regex": "(?:Interest\\s+(?:Term\\s+)?|\\bTerm\\s+)[A-Za-z]+\\s*\\+\\s*([0-9]{2,4}(?:\\.[0-9]+)?)\\b", "group": 1, "type": "bps"},
    {"field": "pik_rate", "regex": "(?:\\(|(?:including|Including|plus)\\s+)([0-9]{2,4}(?:\\.[0-9]+)?)\\s*PIK", "group": 1, "type": "bps"},
    {"field": "interest_rate_floor", "regex": "([0-9]{2,4}(?:\\.[0-9]+)?)\\s*Floor", "group": 1, "type": "bps"},
    {"field": "interest_rate_all_in", "regex": "Interest Rate\\s+([0-9]+(?:\\.[0-9]+)?)\\s*%", "group": 1, "type": "pct"},
    {"field": "maturity_date", "regex": "Maturity\\s*/?\\s*Dissolution Date\\s+([0-9]{1,2}/[0-9]{4})", "group": 1, "type": "date_mdy"}
  ],
  "derivations": {"coupon_type": "floating_if_reference_rate_else_fixed"},
  "invariants": [
    {"name": "all_in_vs_twin", "kind": "pct_agree", "parsed": "interest_rate_all_in", "twin": "interest_rate"},
    {"name": "spread_vs_twin", "kind": "pct_agree", "parsed": "basis_spread", "twin": "basis_spread"},
    {"name": "maturity_vs_twin", "kind": "date_agree", "parsed": "maturity_date", "twin": "maturity_date"},
    {"name": "floating_has_reference", "kind": "implication", "if_present": "basis_spread", "then_present": "reference_rate_type"}
  ],
  "required_fields": ["reference_rate_type", "basis_spread", "interest_rate_all_in"]
}
