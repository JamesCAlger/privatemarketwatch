{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001633336",
  "entity_name": "Crescent Capital BDC, Inc.",
  "version": 3,
  "author": "Agent A2 sandboxed staged proposal from 2026-03-31 bundle 0001633336_2026-03-31.json",
  "applies_to": {
    "regime": "flattened",
    "signature": "DEBT INVTYPE REFRATE RATE MAT"
  },
  "available_identifier_datapoints": [
    "issuer_or_borrower_name", "country_or_region", "asset_category", "industry", "investment_type", "reference_rate_type", "basis_spread", "interest_rate_floor", "pik_rate", "interest_rate_all_in", "maturity_date_month_year", "tranche_or_sequence_suffix"
