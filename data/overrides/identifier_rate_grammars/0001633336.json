{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001633336",
  "entity_name": "Crescent Capital BDC, Inc.",
  "version": 1,
  "author": "Agent A2 sandboxed staged proposal from 2025-12-31 bundle 0001633336_2025-12-31.json",
  "applies_to": {
    "regime": "flattened",
    "signature": "DEBT INVTYPE REFRATE RATE MAT",
    "note": "Dominant debt identifiers embed issuer/industry, investment type, reference-rate code, basis spread, optional floor and PIK terms, all-in interest rate, and mm/yyyy maturity. Observed old and new formats include 'Interest Term S + 500 (100 Floor) (including 100 PIK)' and 'Interest Term S + 600 (100 PIK), 100 Floor'."
  },
  "available_identifier_datapoints": [
    "issuer_or_borrower_name",
    "country_or_region",
    "asset_category",
    "industry",
    "investment_type",
    "reference_rate_type",
    "basis_spread",
    "interest_rate_floor",
    "pik_rate",
    "interest_rate_all_in",
    "maturity_date_month_year",
    "tranche_or_sequence_suffix"
  ],
  "unsupported_identifier_datapoints": [
    "principal_amount",
    "cost",
    "fair_value",
    "currency",
    "shares_or_units",
    "portfolio_company_affiliation_status"
  ],
  "pik_convention": "inclusive",
  "_pik_convention_doc": "The dominant identifiers state PIK inside the rate phrase before an all-in Interest Rate percentage. PIK is parsed as optional and not used as a required field.",
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "(?:Interest\\s+(?:Term\\s+)?|\\bTerm\\s+)([A-Za-z]+)\\s*\\+\\s*[0-9]",
      "group": 1,
      "type": "ref_code",
      "map": {"S": "SOFR", "SF": "SOFR", "SOFR": "SOFR", "L": "LIBOR", "LIBOR": "LIBOR", "P": "PRIME", "PRIME": "PRIME", "E": "EURIBOR", "EURIBOR": "EURIBOR", "C": "CDOR"}
    },
    {
      "field": "basis_spread",
      "regex": "(?:Interest\\s+(?:Term\\s+)?|\\bTerm\\s+)[A-Za-z]+\\s*\\+\\s*([0-9]{2,4}(?:\\.[0-9]+)?)\\b",
      "group": 1,
      "type": "bps"
    },
    {
      "field": "interest_rate_all_in",
      "regex": "Interest Rate\\s+([0-9]+(?:\\.[0-9]+)?)\\s*%",
      "group": 1,
      "type": "pct"
    }
  ],
  "derivations": {
    "coupon_type": "floating_if_reference_rate_else_fixed"
  },
  "invariants": [
    {"name": "all_in_vs_twin", "kind": "pct_agree", "parsed": "interest_rate_all_in", "twin": "interest_rate"},
    {"name": "spread_vs_twin", "kind": "pct_agree", "parsed": "basis_spread", "twin": "basis_spread"},
    {"name": "floating_has_reference", "kind": "implication", "if_present": "basis_spread", "then_present": "reference_rate_type"}
  ],
  "required_fields": ["reference_rate_type", "basis_spread", "interest_rate_all_in"]
}
