{
  "schema": "agentA-rate-grammar.v1",
  "cik": "0001932591",
  "entity_name": "SLR Private Credit BDC II LLC",
  "status": "ACTIVE",
  "applies_to": {
    "regime": "flattened",
    "signature": "RATE"
  },
  "available_identifier_datapoints": [
    "instrument_type",
    "issuer",
    "industry",
    "reference_rate_type",
    "basis_spread",
    "interest_rate_floor",
    "interest_rate",
    "investment_date",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [
    "pik_rate",
    "interest_rate_cash_leg",
    "interest_rate_total"
  ],
  "pik_convention": null,
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "interest_rate"
  ],
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "\\|\\s*([SP])\\+\\d+\\s*\\|",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR",
        "P": "PRIME"
      }
    },
    {
      "field": "basis_spread",
      "regex": "\\|\\s*[SP]\\+(\\d+)\\s*\\|",
      "group": 1,
      "type": "bps",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "\\|\\s*\\d+(?:\\.\\d+)?%\\s*\\|\\s*(\\d+(?:\\.\\d+)?)%\\s*\\|\\s*\\d{1,2}/(?:\\d{1,2}/)?\\d{4}\\s*\\|",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "\\|\\s*(\\d{1,2}/(?:\\d{1,2}/)?\\d{4})\\s*$",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "derivations": {
    "coupon_type": "floating_iff_reference_rate_type"
  },
  "invariants": [
    {
      "name": "interest_rate_matches_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_date_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "spread_implies_reference",
      "kind": "implication",
      "if_present": "basis_spread",
      "then_present": "reference_rate_type"
    }
  ],
  "notes": "Pipe-delimited identifiers embed type, issuer, industry, reference index plus bps spread, floor, all-in interest rate, investment/start date, and maturity. The maturity extractor accepts both M/YYYY and M/D/YYYY eras."
}
