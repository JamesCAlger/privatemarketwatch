{
  "cik": "0001653384",
  "schema_version": "agentA-rate-grammar.v1",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "MAT"
  },
  "pik_convention": "additive",
  "required_fields": [
    "maturity_date"
  ],
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "Interest Rate\\s+(SOFR|PRIME)\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR",
        "PRIME": "PRIME"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Interest Rate\\s+(?:SOFR|PRIME)\\+([0-9]*\\.?[0-9]+)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "Maturity Date\\s+(\\d{1,2}/\\d{1,2}/\\d{4})",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "invariants": [
    {
      "name": "basis_spread_matches_structured_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    },
    {
      "name": "maturity_date_matches_structured_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "floating_reference_implies_spread",
      "kind": "implication",
      "if_present": "reference_rate_type",
      "then_present": "basis_spread"
    }
  ],
  "available_identifier_datapoints": [
    "issuer",
    "affiliation/control bucket",
    "investment asset class",
    "industry/sector",
    "instrument type",
    "reference rate type",
    "basis spread",
    "interest rate floor",
    "PIK rate or PIK description",
    "ETP percentage",
    "initial acquisition date",
    "maturity date"
  ],
  "unsupported_identifier_datapoints": [
    "interest_rate_floor",
    "pik_rate",
    "ETP percentage",
    "initial acquisition date"
  ],
  "notes": [
    "The bundle shows both newer Debt Investments ... Investment Type Senior Secured ... and older Senior Secured Term Loans ... formats; the extractor regexes key on Interest Rate and Maturity Date so they cover both eras.",
    "PIK appears in multiple textual forms, including 1.00% PIK, .25% PIK, and 25% of interest PIK. It is inventoried but not extracted because the required deterministic grammar should avoid optional and convention-ambiguous fields."
  ]
}
