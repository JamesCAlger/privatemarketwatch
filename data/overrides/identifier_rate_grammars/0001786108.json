{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001786108",
  "entity_name": "Trinity Capital Inc.",
  "report_date": "2026-03-31",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "RATE REFRATE",
    "report_dates": [
      "2023-03-31",
      "2023-06-30",
      "2023-09-30",
      "2023-12-31",
      "2024-03-31",
      "2024-06-30",
      "2024-09-30",
      "2024-12-31",
      "2025-03-31",
      "2025-06-30",
      "2025-09-30",
      "2025-12-31",
      "2026-03-31"
    ],
    "identifier_field": "investment_identifier"
  },
  "available_identifier_datapoints": [
    "issuer",
    "investment_category",
    "geography",
    "industry",
    "instrument_type",
    "investment_date",
    "maturity_date",
    "expiration_date",
    "series",
    "coupon_type",
    "reference_rate_type",
    "basis_spread",
    "floor_rate",
    "interest_rate",
    "pik_rate",
    "eot_rate"
  ],
  "unsupported_identifier_datapoints": [
    "principal_amount",
    "cost",
    "fair_value",
    "shares",
    "strike_price",
    "footnotes"
  ],
  "pik_convention": "additive",
  "extractors": [
    {
      "field": "maturity_date",
      "regex": "\\bMaturity\\s*Date\\s*([A-Z][a-z]+\\s+\\d{1,2},\\s*\\d{4})\\b",
      "group": 1,
      "type": "date_mdy"
    },
    {
      "field": "reference_rate_type",
      "regex": "\\bVariable interest rate\\s+(Prime|PRIME|Base Rate|SOFR 30 Day Forward|SOFR \\d+ Month Term|LIBOR|0)\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "Prime": "PRIME",
        "PRIME": "PRIME",
        "Base Rate": "BASE_RATE",
        "SOFR 30 Day Forward": "SOFR_30D_FORWARD",
        "SOFR 1 Month Term": "SOFR_1M_TERM",
        "SOFR 3 Month Term": "SOFR_3M_TERM",
        "LIBOR": "LIBOR",
        "0": "ZERO"
      }
    },
    {
      "field": "basis_spread",
      "regex": "\\bVariable interest rate\\s+(?:Prime|PRIME|Base Rate|SOFR 30 Day Forward|SOFR \\d+ Month Term|LIBOR|0)\\s*\\+\\s*([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate",
      "regex": "\\bFixed interest rate\\s+([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "\\+\\s*PIK Fixed Interest Rate\\s+([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "floor_rate",
      "regex": "\\bor Floor rate\\s+([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct"
    }
  ],
  "derivations": {
    "coupon_type": [
      {
        "when": "reference_rate_type is present",
        "value": "floating"
      },
      {
        "when": "interest_rate is present and reference_rate_type is absent",
        "value": "fixed"
      }
    ]
  },
  "required_fields": [
    "basis_spread"
  ],
  "invariants": [
    {
      "name": "maturity_date_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "basis_spread_matches_twin_when_present",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    },
    {
      "name": "fixed_rate_matches_twin_when_present",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    }
  ],
  "evidence": [
    {
      "accession_number": "0001193125-26-207620",
      "table_index": null,
      "row_index": null,
      "observation": "Recent bundle samples contain Prime/PRIME variable-rate clauses with maturity date, spread, floor rate, optional PIK, and EOT text embedded in the identifier."
    },
    {
      "accession_number": "0000950170-24-026865",
      "table_index": null,
      "row_index": null,
      "observation": "Older bundle samples contain SOFR 30 Day Forward variable-rate clauses and fixed-rate clauses embedded in the identifier."
    },
    {
      "accession_number": "0000950170-23-017817",
      "table_index": null,
      "row_index": null,
      "observation": "Oldest bundle samples include LIBOR plus spread clauses and fixed-rate clauses; some dates omit a space after the comma."
    }
  ],
  "notes": [
    "basis_spread is encoded as percent text in identifiers, so type pct is used rather than bps.",
    "The regexes allow non-breaking-space-normalized spacing variants and dates with no space after the comma.",
    "Only fields embedded in investment_identifier strings are extracted; principal, cost, fair value, shares, strike price, and footnotes are not identifier datapoints.",
    "The evidence CLI could not run in this worker because pandas is unavailable, so observations are grounded in the allowed bundle samples and existing read-only production override context."
  ]
}
