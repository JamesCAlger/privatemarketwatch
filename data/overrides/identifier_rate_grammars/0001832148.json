{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001832148",
  "entity_name": "SLR HC BDC LLC",
  "available_identifier_datapoints": [
    "instrument_type",
    "issuer",
    "industry",
    "reference_rate_type",
    "basis_spread",
    "interest_rate_floor",
    "interest_rate",
    "origination_date",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [
    "pik_rate"
  ],
  "applies_to": {
    "regime": "flattened",
    "signature": "RATE"
  },
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "interest_rate"
  ],
  "pik_convention": null,
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "\\|\\s*([SL])\\s*\\+\\s*\\d+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR",
        "L": "LIBOR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "\\|\\s*[SL]\\s*\\+\\s*(\\d+(?:\\.\\d+)?)",
      "group": 1,
      "type": "bps",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "\\|\\s*\\d+(?:\\.\\d+)?%\\s*\\|\\s*(\\d+(?:\\.\\d+)?)%?\\s*\\|",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "\\|\\s*\\d{1,2}/(?:\\d{1,2}/)?\\d{4}\\s*\\|\\s*(\\d{1,2}/\\d{1,2}/\\d{4})\\s*$",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "invariants": [
    {
      "name": "interest_rate_matches_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_date_matches_twin_when_full_date_present",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ]
}
