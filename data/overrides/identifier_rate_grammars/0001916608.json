{
  "schema": "agentA-rate-grammar.v1",
  "cik": "0001916608",
  "applies_to": {
    "regime": "flattened",
    "signature": "RATE REFRATE MAT",
    "_resolved_by": "harness resolve_applies_to (committed anchors)"
  },
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "(?i)\\((SOFR)\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "(?i)\\bSOFR\\s*\\+\\s*([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate_floor",
      "regex": "(?i)([0-9]+(?:\\.[0-9]+)?)%\\s*Floor",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "pik_rate",
      "regex": "(?i)([0-9]+(?:\\.[0-9]+)?)%\\s*PIK",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "(?i)Maturity Date\\s*(?:-\\s*)?([0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4})",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "required_fields": [
    "interest_rate"
  ],
  "pik_convention": "inclusive",
  "derivations": {
    "coupon_type": "floating_iff_reference"
  },
  "invariants": [
    {
      "name": "interest_rate_matches_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_date_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ]
}