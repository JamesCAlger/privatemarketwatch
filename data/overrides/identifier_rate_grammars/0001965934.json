{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001965934",
  "entity_name": "Overland Advantage",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "AFFIL SECDEBT ASSETTYPE RATE REFRATE MAT"
  },
  "available_identifier_datapoints": [
    "issuer",
    "industry",
    "affiliation_status",
    "asset_class",
    "instrument_type",
    "lien_rank",
    "reference_rate_type",
    "basis_spread",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [
    "pik_rate",
    "interest_rate_floor",
    "interest_rate_cash_leg",
    "interest_rate_total"
  ],
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "maturity_date"
  ],
  "pik_convention": "none",
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "Interest Rate\\s+([A-Z][A-Z0-9 /-]*)\\s*\\+\\s*[0-9]+(?:\\.[0-9]+)?%",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Interest Rate\\s+[A-Z][A-Z0-9 /-]*\\s*\\+\\s*([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "Maturity Date\\s+(\\d{1,2}/\\d{1,2}/\\d{4})",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "derivations": [
    {
      "field": "coupon_type",
      "rule": "floating_iff_reference_rate_type_present"
    }
  ],
  "invariants": [
    {
      "name": "basis_spread_agrees_with_structured_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    },
    {
      "name": "maturity_date_agrees_with_structured_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "reference_implies_spread",
      "kind": "implication",
      "if_present": "reference_rate_type",
      "then_present": "basis_spread"
    }
  ],
  "notes": [
    "Dominant identifiers embed Interest Rate SOFR + X.XX% and Maturity Date M/D/YYYY or MM/DD/YYYY across 2024-06-30 through 2026-03-31 samples.",
    "Aggregate candidate AFFIL SECDEBT rows carry industry/category text only and are excluded from required rate fields."
  ]
}
