{
  "cik": "0002020354",
  "entity_name": "West Bay BDC LLC",
  "schema": "agentA-rate-grammar.v1",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "SECDEBT ASSETTYPE RATE REFRATE MAT"
  },
  "available_identifier_datapoints": [
    "issuer",
    "country_or_region",
    "asset_category",
    "instrument_type",
    "interest_rate",
    "reference_rate_type",
    "basis_spread",
    "pik_rate",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [
    "cash_interest_rate_leg",
    "interest_rate_floor",
    "commitment_amount",
    "fair_value"
  ],
  "pik_convention": "inclusive",
  "required_fields": [
    "basis_spread",
    "reference_rate_type",
    "maturity_date"
  ],
  "extractors": [
    {
      "field": "interest_rate",
      "regex": "\\bInterest Rate\\s+([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "reference_rate_type",
      "regex": "\\bReference Rate\\s*(?:and|\\u00a0and)\\s*Spread\\s+([A-Za-z]+)\\s*\\+\\s*[0-9]+(?:\\.[0-9]+)?%",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "\\bReference Rate\\s*(?:and|\\u00a0and)\\s*Spread\\s+[A-Za-z]+\\s*\\+\\s*([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "pik_rate",
      "regex": "\\(Incl\\.\\s+([0-9]+(?:\\.[0-9]+)?)%\\s+PIK\\)",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "\\bMaturity\\s+([0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4})\\b",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "derivations": [
    {
      "field": "coupon_type",
      "from": "reference_rate_type",
      "map": {
        "present": "floating"
      }
    }
  ],
  "invariants": [
    {
      "name": "basis_spread_matches_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    },
    {
      "name": "interest_rate_matches_twin_when_present",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "spread_implies_reference_rate_type",
      "kind": "implication",
      "if_present": "basis_spread",
      "then_present": "reference_rate_type"
    }
  ],
  "notes": [
    "Dominant identifiers embed Reference Rate and Spread S + 4.75%, optional Incl. 2.00% PIK, and Maturity M/D/YY across old Investment-prefixed and newer non-prefixed formats.",
    "Interest Rate is not required because one 2025-03-31 dominant sample omits the Interest Rate phrase while preserving spread and maturity."
  ]
}
