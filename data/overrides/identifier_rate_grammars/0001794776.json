{
  "schema": "agentA-rate-grammar.v1",
  "cik": "0001794776",
  "status": "PROPOSED",
  "available_identifier_datapoints": [
    "issuer",
    "instrument_type",
    "industry",
    "interest_rate",
    "reference_rate_type",
    "basis_spread",
    "pik_rate",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [
    "cash_leg_rate",
    "interest_rate_floor"
  ],
  "applies_to": {
    "regime": "flattened",
    "signature": "SECDEBT RATE REFRATE MAT"
  },
  "required_fields": [
    "interest_rate",
    "reference_rate_type",
    "basis_spread",
    "maturity_date"
  ],
  "pik_convention": "inclusive",
  "extractors": [
    {
      "field": "interest_rate",
      "regex": "Interest Rate\\s+([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "reference_rate_type",
      "regex": "\\((S|SOFR)\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR",
        "SOFR": "SOFR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "\\((?:S|SOFR)\\s*(?:\\+\\s*CSA\\s*)?\\+\\s*([0-9]+(?:\\.[0-9]+)?)\\s*%?",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "incl\\.?\\s*([0-9]+(?:\\.[0-9]+)?)\\s*(?:%|bp)\\s*PIK",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "Maturity Date\\s+([0-9]{1,2}/[0-9]{1,2}/[0-9]{4})",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "invariants": [
    {
      "name": "interest_rate_matches_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "basis_spread_matches_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    },
    {
      "name": "maturity_date_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ]
}
