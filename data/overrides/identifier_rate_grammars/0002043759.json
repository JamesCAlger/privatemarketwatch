{
  "schema": "agentA-rate-grammar.v1",
  "cik": "0002043759",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "AFFIL SECDEBT ASSETTYPE RATE REFRATE MAT"
  },
  "available_identifier_datapoints": [
    "affiliation_bucket",
    "asset_class",
    "industry",
    "issuer",
    "instrument_type",
    "tranche",
    "reference_rate_type",
    "basis_spread",
    "pik_rate",
    "fixed_interest_rate",
    "maturity_date",
    "investment_date",
    "expiration_date",
    "equity_series"
  ],
  "unsupported_identifier_datapoints": [
    "fair_value",
    "cost",
    "principal_amount",
    "shares_or_units"
  ],
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "\\b(?:Interest|Investment) Rate\\s+(SOFR|PSOFR|PRIME)\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR",
        "PSOFR": "PSOFR",
        "PRIME": "PRIME"
      }
    },
    {
      "field": "basis_spread",
      "regex": "\\b(?:Interest|Investment) Rate\\s+(?:SOFR|PSOFR|PRIME)\\s*\\+\\s*([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "pik_rate",
      "regex": "\\b([0-9]+(?:\\.[0-9]+)?)%\\s*PIK\\b",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "\\b(?:Interest|Investment) Rate\\s+([0-9]+(?:\\.[0-9]+)?)%\\s+fixed\\b",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "\\bMaturity Date\\s+([0-9]{1,2}/[0-9]{1,2}/[0-9]{4})\\b",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "required_fields": [
    "maturity_date"
  ],
  "pik_convention": "additive",
  "derivations": [
    {
      "field": "coupon_type",
      "rule": "floating_if_reference_rate_type_present_else_fixed"
    }
  ],
  "invariants": [
    {
      "name": "maturity_date_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "basis_spread_matches_twin_when_present",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    }
  ],
  "notes": "Identifier strings embed old and new eras: Interest Rate and Investment Rate labels; PIK as comma form and parenthetical form; floating rates SOFR, PSOFR, and PRIME; fixed coupons such as 15% fixed; and M/D/YYYY maturity dates."
}
