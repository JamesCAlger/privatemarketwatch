{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001715933",
  "entity_name": "TCW Direct Lending VII LLC",
  "report_date": "2025-12-31",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "DEBT RATE REFRATE MAT"
  },
  "available_identifier_datapoints": [
    "section_or_asset_class",
    "industry_or_category",
    "issuer",
    "acquisition_date",
    "instrument_type",
    "tranche_or_position_descriptor",
    "interest_rate",
    "reference_rate_type",
    "basis_spread",
    "interest_rate_floor",
    "pik_terms_text",
    "pik_rate",
    "pct_of_net_assets",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [
    "principal_or_par_amount",
    "amortized_cost",
    "fair_value",
    "share_or_unit_count"
  ],
  "pik_convention": "inclusive",
  "extractors": [
    {
      "field": "interest_rate",
      "regex": "-\\s*(\\d+(?:\\.\\d+)?)\\s*%\\s*(?:inc\\s+PIK)?",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "reference_rate_type",
      "regex": "\\((SOFR|PRIME)\\s*\\+\\s*\\d+(?:\\.\\d+)?\\s*%",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR",
        "PRIME": "PRIME"
      }
    },
    {
      "field": "basis_spread",
      "regex": "\\((?:SOFR|PRIME)\\s*\\+\\s*(\\d+(?:\\.\\d+)?)\\s*%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate_floor",
      "regex": ",\\s*(\\d+(?:\\.\\d+)?)\\s*%\\s*Floor",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": ",\\s*(\\d+(?:\\.\\d+)?)\\s*%\\s*PIK\\)",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "Maturity Date\\s+(\\d{2}/\\d{2}/\\d{2})",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "required_fields": [
    "interest_rate",
    "reference_rate_type",
    "basis_spread",
    "maturity_date"
  ],
  "invariants": [
    {
      "name": "interest_rate_identifier_matches_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "basis_spread_identifier_matches_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    },
    {
      "name": "maturity_date_identifier_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "reference_rate_implies_spread",
      "kind": "implication",
      "if_present": "reference_rate_type",
      "then_present": "basis_spread"
    }
  ],
  "evidence": [
    {
      "accession_number": "0001193125-26-141887",
      "table_index": 24,
      "row_index": 4,
      "observation": "Recent debt identifiers embed rate, SOFR spread, floor, PIK wording, percent of net assets, and maturity date."
    },
    {
      "accession_number": "0000950170-23-020312",
      "table_index": 24,
      "row_index": 4,
      "observation": "Oldest-era bundle samples use the same rate/reference/spread/floor/PIK/maturity pattern with two-digit maturity dates."
    }
  ],
  "notes": "Grammar extracts only datapoints present in the investment_identifier text. It does not use source-table amount, cost, value, or share columns."
}
