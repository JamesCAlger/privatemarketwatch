{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001993402",
  "entity_name": "Antares Strategic Credit Fund",
  "version": 1,
  "author": "hand-authored P1 (pre-agent); Antares debt signature",
  "applies_to": {
    "regime": "flattened",
    "signature": "AFFIL SECDEBT ASSETTYPE REFRATE RATE MAT",
    "note": "rate-bearing first/second-lien debt; equity/revolver signatures are separate grammars (later phases)"
  },
  "pik_convention": "inclusive",
  "_pik_convention_doc": "Stated Interest Rate is the ALL-IN coupon; '(Incl. X% PIK)' means PIK is included, so cash_leg = all_in - pik. (Contrast MidCap 'cash + pik' = additive.)",
  "extractors": [
    {
      "field": "instrument_type",
      "regex": "Asset Type\\s+(?:One\\s+)?(.+?)\\s+Reference Rate and Spread",
      "group": 1,
      "type": "text"
    },
    {
      "field": "reference_rate_type",
      "regex": "Reference Rate and Spread\\s+([A-Za-z]+)\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {"S": "SOFR", "SF": "SOFR", "L": "LIBOR", "P": "PRIME", "E": "EURIBOR"}
    },
    {
      "field": "basis_spread",
      "regex": "Reference Rate and Spread\\s+[A-Za-z]+\\s*\\+\\s*([0-9.]+)\\s*%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate_floor",
      "regex": "Interest Rate Floor\\s+([0-9.]+)\\s*%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate_all_in",
      "regex": "Interest Rate\\s+(?!Floor)([0-9.]+)\\s*%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "Incl\\.?\\s+([0-9.]+)\\s*%\\s*PIK",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "Maturity Date\\s+([0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4})",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "derivations": {
    "coupon_type": "floating_if_reference_rate_else_fixed",
    "interest_rate_cash_leg": "interest_rate_all_in_minus_pik"
  },
  "invariants": [
    {"name": "all_in_vs_twin", "kind": "pct_agree", "parsed": "interest_rate_all_in", "twin": "interest_rate", "tol": 0.05},
    {"name": "spread_vs_twin", "kind": "pct_agree", "parsed": "basis_spread", "twin": "basis_spread", "tol": 0.05},
    {"name": "pik_vs_twin", "kind": "pct_agree", "parsed": "pik_rate", "twin": "pik_rate", "tol": 0.05},
    {"name": "maturity_vs_twin", "kind": "date_agree", "parsed": "maturity_date", "twin": "maturity_date"},
    {"name": "floating_has_reference", "kind": "implication", "if_present": "basis_spread", "then_present": "reference_rate_type"}
  ]
}
