{
  "schema": "agentA-rate-grammar.v1",
  "cik": "0001919369",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "INVESTMENTS AFFIL SECDEBT REFRATE RATE MAT"
  },
  "pik_convention": "additive",
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "maturity_date"
  ],
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "Reference Rate and Spread\\s+([A-Z][A-Z0-9-]*)\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Reference Rate and Spread\\s+[A-Z][A-Z0-9-]*\\s*\\+\\s*([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "pik_rate",
      "regex": "\\(([0-9]+(?:\\.[0-9]+)?)%\\s*PIK\\)",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "Interest Rate\\s+([0-9]+\\.[0-9]+)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "Interest Rate\\s+([0-9]{3})(?=%)",
      "group": 1,
      "type": "bps",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "Maturity Date\\s+([0-9]{1,2}/[0-9]{1,2}/[0-9]{4})",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "invariants": [
    {
      "name": "maturity_date_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "basis_spread_matches_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    }
  ],
  "available_identifier_datapoints": [
    "issuer",
    "affiliation",
    "instrument_type",
    "industry",
    "reference_rate_type",
    "basis_spread",
    "pik_rate",
    "interest_rate",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [
    "interest_rate_floor",
    "interest_rate_cash_leg",
    "principal_amount",
    "fair_value"
  ]
}
