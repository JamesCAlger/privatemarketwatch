{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001899017",
  "entity_name": "Bain Capital Private Credit",
  "report_date": "2025-12-31",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "AFFIL REFRATE RATE MAT",
    "report_dates": [
      "2025-12-31"
    ]
  },
  "available_identifier_datapoints": [
    "affiliation_section",
    "industry_or_asset_section",
    "issuer",
    "instrument_type",
    "tranche_or_facility_type",
    "reference_rate_type",
    "basis_spread",
    "pik_rate",
    "interest_rate",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [
    "floor_rate",
    "cash_interest_rate_leg",
    "original_issue_discount",
    "commitment_amount"
  ],
  "pik_convention": "additive",
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "\\b(?P<reference_rate_type>SOFR|EURIBOR)\\s+Spread\\b",
      "group": 1,
      "map": {
        "SOFR": "SOFR",
        "EURIBOR": "EURIBOR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "\\b(?:SOFR|EURIBOR)\\s+Spread\\s+(?P<basis_spread>[0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "\\((?P<pik_rate>[0-9]+(?:\\.[0-9]+)?)%\\s+PIK\\)",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate",
      "regex": "\\bInterest Rate\\s+(?P<interest_rate>[0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "\\bMaturity Date\\s+(?P<maturity_date>[0-9]{1,2}/[0-9]{1,2}/[0-9]{4})\\b",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "derivations": {
    "coupon_type": {
      "floating_if": "reference_rate_type",
      "fixed_if_no_reference_rate": true
    }
  },
  "required_fields": [
    "maturity_date"
  ],
  "invariants": [
    {
      "name": "basis_spread_matches_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    },
    {
      "name": "interest_rate_matches_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_date_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ],
  "evidence": [
    {
      "accession_number": "0001193125-26-104390",
      "table_index": 56,
      "row_index": 1,
      "observation": "SOI headers include Index, Spread, Interest Rate, and Maturity Date fields."
    },
    {
      "accession_number": "0001193125-26-104390",
      "bundle_sample": "Chase Industries, Inc. First Lien Senior Secured Loan SOFR Spread 5.65% (1.50% PIK) Interest Rate 10.82% Maturity Date 11/11/2027",
      "observation": "Identifier embeds reference rate, spread, PIK rate, stated interest rate, and maturity date."
    }
  ],
  "notes": "Extractor proposal is limited to datapoints embedded in investment_identifier strings. PIK is optional and not required."
}
