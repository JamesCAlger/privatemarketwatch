{
  "schema": "agentA-rate-grammar.v1",
  "cik": "0001890107",
  "entity_name": "First Eagle Private Credit Fund",
  "report_date": "2025-12-31",
  "status": "PROPOSED",
  "signature": "AFFIL REFRATE RATE MAT",
  "applies_to": {
    "regime": "flattened",
    "signature": "AFFIL REFRATE RATE MAT"
  },
  "available_identifier_datapoints": [
    "affiliation_section",
    "instrument_type",
    "industry",
    "issuer_or_position_name",
    "region",
    "reference_rate_type",
    "basis_spread",
    "pik_rate",
    "interest_rate_floor",
    "interest_rate",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [],
  "pik_convention": "inclusive",
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "Reference Rate and Spread\\s+(?P<reference_rate_type>S)\\s*\\+\\s*(?P<basis_spread_pct>\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Reference Rate and Spread\\s+S\\s*\\+\\s*(?P<basis_spread_pct>\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "\\(incl\\.\\s*(?P<pik_rate_pct>\\d+(?:\\.\\d+)?)%\\s+PIK\\)",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate_floor",
      "regex": "Interest Rate Floor\\s+(?P<interest_rate_floor_pct>\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate",
      "regex": "Interest Rate\\s+(?P<interest_rate_pct>\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "Maturity Date\\s+(?P<maturity_date>\\d{1,2}/\\d{1,2}/\\d{4})",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "derivations": {
    "coupon_type": {
      "rule": "floating_if_reference_rate_type_present"
    }
  },
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "interest_rate",
    "maturity_date"
  ],
  "optional_fields": [
    "pik_rate",
    "interest_rate_floor"
  ],
  "invariants": [
    {
      "name": "basis_spread_matches_structured_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread",
      "tolerance": 0.0001
    },
    {
      "name": "interest_rate_matches_structured_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate",
      "tolerance": 0.0001
    },
    {
      "name": "pik_rate_matches_structured_twin_when_present",
      "kind": "pct_agree",
      "parsed": "pik_rate",
      "twin": "pik_rate",
      "tolerance": 0.0001,
      "required": false
    },
    {
      "name": "maturity_date_matches_structured_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ],
  "evidence": [
    {
      "source": "bundle samples",
      "observation": "Dominant variant is AFFIL REFRATE RATE MAT for 199 of 200 rows; sample identifiers include Reference Rate and Spread S + x%, optional '(incl. x% PIK)', Interest Rate Floor, Interest Rate, and Maturity Date."
    },
    {
      "source": "evidence_cli roam",
      "table_index": 42,
      "row_index": 1,
      "observation": "SOI header confirms separate columns for Reference Rate and Spread, Interest Rate Floor, Interest Rate, and Maturity Date."
    }
  ],
  "notes": "One AFFIL-only warrant row has no rate or maturity fields and should remain outside this rate grammar."
}
