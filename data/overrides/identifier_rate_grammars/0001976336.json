{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001976336",
  "entity_name": "Antares Private Credit Fund",
  "version": 1,
  "author": "agentA2 staged proposal from bundle 0001976336_2025-12-31.json",
  "available_identifier_datapoints": [
    "affiliation_section",
    "asset_class_section",
    "industry",
    "issuer",
    "instrument_type",
    "reference_rate_type",
    "basis_spread",
    "interest_rate_all_in",
    "pik_rate",
    "maturity_date",
    "commitment_type",
    "commitment_expiration_date",
    "equity_asset_type",
    "preferred_pik_rate"
  ],
  "unsupported_identifier_datapoints": [
    "interest_rate_floor",
    "cash_interest_rate_leg",
    "par_amount",
    "amortized_cost",
    "fair_value",
    "pct_of_net_assets"
  ],
  "applies_to": {
    "regime": "flattened",
    "signature": "AFFIL SECDEBT REFRATE RATE MAT",
    "note": "Dominant secured-debt variant has 861 rows, 67.2% of the bundle. Identifiers embed Asset Type, Reference Rate and Spread, Interest Rate, optional parenthetical PIK, and Maturity Date. Evidence CLI confirmed the source table header at table 37 row 1 and GSP Holdings example at table 37 row 6. Commitment and equity variants are separate populations and are not covered by this debt grammar."
  },
  "pik_convention": "inclusive",
  "_pik_convention_doc": "The identifier/source text states forms such as Interest Rate 10.30% (Incl. 0.75% PIK). 'Incl.' indicates the PIK component is included in the stated all-in interest rate, so a cash leg, if derived, is all_in minus PIK. PIK is optional and is not required.",
  "extractors": [
    {
      "field": "instrument_type",
      "regex": "Asset Type\\s+(.+?)\\s+Reference Rate and Spread",
      "group": 1,
      "type": "text"
    },
    {
      "field": "reference_rate_type",
      "regex": "Reference Rate and Spread\\s+([A-Za-z]+)\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR",
        "SOFR": "SOFR",
        "SF": "SOFR",
        "L": "LIBOR",
        "LIBOR": "LIBOR",
        "P": "PRIME",
        "PRIME": "PRIME",
        "E": "EURIBOR",
        "EURIBOR": "EURIBOR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Reference Rate and Spread\\s+[A-Za-z]+\\s*\\+\\s*([0-9.]+)\\s*%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate_all_in",
      "regex": "Interest Rate\\s+([0-9.]+)\\s*%\\s*(?:\\([^)]*\\))?",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "Incl(?:\\.|ude)?\\s+([0-9.]+)\\s*%\\s*PIK",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "Maturity Date\\s+([0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4})",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "derivations": {
    "coupon_type": "floating_if_reference_rate_else_fixed",
    "interest_rate_cash_leg": "interest_rate_all_in_minus_pik"
  },
  "invariants": [
    {
      "name": "all_in_vs_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate_all_in",
      "twin": "interest_rate",
      "tol": 0.05
    },
    {
      "name": "spread_vs_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread",
      "tol": 0.05
    },
    {
      "name": "pik_vs_twin",
      "kind": "pct_agree",
      "parsed": "pik_rate",
      "twin": "pik_rate",
      "tol": 0.05
    },
    {
      "name": "maturity_vs_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "floating_has_reference",
      "kind": "implication",
      "if_present": "basis_spread",
      "then_present": "reference_rate_type"
    }
  ],
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "interest_rate_all_in",
    "maturity_date"
  ]
}
