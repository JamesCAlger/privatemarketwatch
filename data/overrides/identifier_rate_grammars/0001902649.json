{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001902649",
  "entity_name": "BlackRock Private Credit Fund",
  "report_date": "2025-12-31",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "REFRATE RATE MAT",
    "report_dates": [
      "2025-12-31"
    ],
    "signatures": [
      "REFRATE RATE MAT",
      "RATE REFRATE MAT",
      "RATE MAT"
    ]
  },
  "available_identifier_datapoints": [
    "issuer",
    "asset_class",
    "industry",
    "instrument_type",
    "reference_rate",
    "floor",
    "spread",
    "cash_pik_split",
    "total_coupon",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [],
  "dominant_signature": "REFRATE RATE MAT",
  "pik_convention": "additive",
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "interest_rate",
    "maturity_date"
  ],
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "\\bRef\\s+(?P<reference_rate_type>[A-Z]+)(?:\\([A-Z]\\))?\\b",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR",
        "EURIBOR": "EURIBOR",
        "CORRA": "CORRA"
      }
    },
    {
      "field": "floor",
      "regex": "\\bFloor\\s+(?P<floor_pct>\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "basis_spread",
      "regex": "\\bSpread\\s+(?P<basis_spread_pct>\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "\\bCash\\s+\\+\\s+(?P<pik_rate_pct>\\d+(?:\\.\\d+)?)%\\s+PIK\\b",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate",
      "regex": "\\bTotal Coupon\\s+(?P<interest_rate_pct>\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "\\bMaturity(?:\\s+Date)?\\s+(?P<maturity_date>\\d{1,2}/\\d{1,2}/\\d{4})",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "derivations": {
    "coupon_type": "floating_iff_reference_rate_type_present"
  },
  "invariants": [
    {
      "name": "interest_rate_matches_structured_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate",
      "tolerance": 0.0002
    },
    {
      "name": "basis_spread_matches_structured_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread",
      "tolerance": 0.0002
    },
    {
      "name": "maturity_date_matches_structured_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ],
  "evidence": [
