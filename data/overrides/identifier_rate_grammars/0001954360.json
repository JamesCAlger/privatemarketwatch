{
  "schema": "agentA-rate-grammar.v1",
  "cik": "0001954360",
  "entity_name": "Crescent Private Credit Income Corp",
  "status": "ACTIVE",
  "applies_to": {"regime": "flattened", "signature": "SECDEBT ASSETTYPE REFRATE RATE MAT"},
  "available_identifier_datapoints": [
    "issuer", "investment_type", "reference_rate_type", "basis_spread",
    "pik_rate", "interest_rate_floor", "interest_rate", "maturity_date"
  ],
  "unsupported_identifier_datapoints": [
    "interest_rate_cash_leg", "interest_rate_all_in", "interest_rate_total"
  ],
  "pik_convention": "inclusive",
  "required_fields": ["reference_rate_type", "basis_spread", "interest_rate"],
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "\\bInterest Term\\s+([A-Z])\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {"S": "SOFR", "E": "EURIBOR", "B": "BASE", "P": "PRIME"}
    },
    {
      "field": "basis_spread",
      "regex": "\\bInterest Term\\s+[A-Z]\\s*\\+\\s*([0-9]+(?:\\.[0-9]+)?)",
      "group": 1,
      "type": "bps",
      "map": {}
    },
    {
      "field": "pik_rate",
      "regex": "\\bInterest Term\\b.*?(?:\\(|\\s)(?:plus\\s+|including\\s+)?([0-9]+(?:\\.[0-9]+)?)\\s+PIK\\b",
      "group": 1,
      "type": "bps",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "\\bInterest Rate\\s+([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "\\bMaturity\\s*/?\\s*Dissolution Date\\s+([0-9]{1,2}/(?:[0-9]{1,2}/)?[0-9]{4})",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "invariants": [
    {"name": "interest_rate_matches_bundle_twin", "kind": "pct_agree", "parsed": "interest_rate", "twin": "interest_rate"},
    {"name": "maturity_matches_bundle_twin_when_available", "kind": "date_agree", "parsed": "maturity_date", "twin": "maturity_date"},
    {"name": "floating_reference_implies_spread", "kind": "implication", "if_present": "reference_rate_type", "then_present": "basis_spread"}
  ],
  "notes": [
    "Dominant RATE identifiers embed Interest Term, Interest Rate, and Maturity/Dissolution Date across old and new eras.",
    "PIK is optional and appears as bare parenthetical, plus PIK, including PIK, or standalone PIK language.",
    "Some structured twins show inconsistent spread/PIK scaling in older quarters, so spread and PIK are extracted as bps from identifier text."
  ]
}
