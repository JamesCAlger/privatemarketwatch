{
  "schema": "agentA-rate-grammar.v1",
  "cik": "0001603480",
  "status": "ACTIVE",
  "applies_to": {
    "regime": "flattened",
    "signature": "DEBT TERMLOAN"
  },
  "available_identifier_datapoints": [
    "issuer",
    "industry",
    "country",
    "instrument_type",
    "tranche",
    "origination_date",
    "interest_rate",
    "reference_rate_type",
    "basis_spread",
    "interest_rate_floor",
    "pik_rate",
    "maturity_date",
    "net_assets_percent"
  ],
  "unsupported_identifier_datapoints": [
    "origination_date",
    "interest_rate_floor",
    "net_assets_percent"
  ],
  "pik_convention": "inclusive",
  "required_fields": [
    "interest_rate"
  ],
  "extractors": [
    {
      "field": "interest_rate",
      "regex": ".*\\bTerm Loan(?:\\s+[A-Z])?\\b\\s*[\\-\\u2013]\\s*([0-9]+(?:\\.[0-9]+)?)%.*",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "reference_rate_type",
      "regex": ".*\\((SOFR|LIBOR)\\s*\\+.*",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR",
        "LIBOR": "LIBOR"
      }
    },
    {
      "field": "basis_spread",
      "regex": ".*\\((?:SOFR|LIBOR)\\s*\\+\\s*([0-9]+(?:\\.[0-9]+)?)%.*",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": ".*,\\s*([0-9]+(?:\\.[0-9]+)?)%\\s+PIK\\).*",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": ".*\\bMaturity\\s+([0-9]{1,2}/[0-9]{1,2}/[0-9]{2})\\b.*",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "derivations": [
    {
      "field": "coupon_type",
      "type": "floating_iff_reference_rate"
    }
  ],
  "invariants": [
    {
      "name": "interest_rate_matches_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_date_matches_twin_when_embedded",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "spread_requires_reference",
      "kind": "implication",
      "if_present": "basis_spread",
      "then_present": "reference_rate_type"
    }
  ],
  "notes": "Debt term-loan identifiers embed issuer/context, origination Date, instrument/tranche, stated coupon percent, optional SOFR/LIBOR spread and PIK terms, Net Assets percent, and Maturity date. Equity/common/preferred and debt aggregate identifiers do not carry rate datapoints. Net Assets percent and floor values are embedded but intentionally not extracted as rate grammar fields."
}
