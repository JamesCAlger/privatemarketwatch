{
  "schema": "agentA-rate-grammar.v1",
  "cik": "0001983514",
  "entity_name": "LGAM Private Credit LLC",
  "report_date": "2025-12-31",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "AFFIL REFRATE RATE MAT"
  },
  "available_identifier_datapoints": [
    "issuer",
    "investment_category",
    "affiliation_status",
    "industry",
    "instrument_type",
    "reference_rate_type",
    "basis_spread",
    "pik_rate",
    "interest_rate",
    "maturity_date",
    "duplicate_suffix"
  ],
  "unsupported_identifier_datapoints": [
    "par_amount",
    "cost",
    "fair_value",
    "percentage_of_net_assets",
    "interest_rate_floor",
    "interest_rate_cash_leg"
  ],
  "pik_convention": "inclusive",
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "\\bReference Rate and Spread\\s+(S)\\s*\\+\\s*\\d+(?:\\.\\d+)?%",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "\\bReference Rate and Spread\\s+S\\s*\\+\\s*(\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "\\(\\s*incl\\.\\s*(\\d+(?:\\.\\d+)?)%\\s+PIK\\s*\\)",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate",
      "regex": "\\bInterest Rate\\s+(\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "\\bMaturity Date\\s+(\\d{1,2}/\\d{1,2}/\\d{4})\\b",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "derivations": {
    "coupon_type": "floating_iff_reference_rate_type_present"
  },
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "interest_rate",
    "maturity_date"
  ],
  "invariants": [
    {
      "name": "basis_spread_matches_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    },
    {
      "name": "interest_rate_matches_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_date_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "spread_implies_reference",
      "kind": "implication",
      "if_present": "basis_spread",
      "then_present": "reference_rate_type"
    }
  ],
  "evidence": [
    {
      "source": "bundle.top_variants[0].samples",
      "observation": "Dominant debt identifiers across 2025-09-30 through 2026-03-31 include Reference Rate and Spread S + spread%, optional incl. PIK text, Interest Rate percent, and Maturity Date in M/D/Y or MM/DD/YYYY form."
    },
    {
      "source": "bundle.top_variants[2].samples",
      "observation": "Equity identifiers carry issuer and equity type only; their structured rate-like twins are not embedded identifier datapoints and are excluded from this grammar."
    },
    {
      "source": "bundle.none_examples",
      "observation": "Issuer-only none examples such as iCIMS, Inc. and Associations, Inc. do not carry rate/date datapoints."
    }
  ]
}
