{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001782524",
  "entity_name": "Morgan Stanley Direct Lending Fund",
  "version": 1,
  "author": "agentA A2 sandbox proposal from bundle 0001782524_2025-12-31.json",
  "applies_to": {
    "regime": "flattened",
    "signature": "AFFIL SECDEBT POSITION REFRATE RATE MAT"
  },
  "available_identifier_datapoints": [
    "issuer or investment name",
    "industry or category text in newer flattened identifiers",
    "instrument type or tranche",
    "reference rate code when present",
    "basis spread percentage",
    "PIK rate when identifier includes an 'incl. X% PIK' phrase",
    "all-in interest rate when numeric text follows 'Interest Rate'",
    "maturity date"
  ],
  "unsupported_identifier_datapoints": [
    "principal amount",
    "cost",
    "fair value",
    "percent of net assets",
    "interest rate floor",
    "cash interest leg separate from PIK"
  ],
  "pik_convention": "inclusive",
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "Reference Rate and Spread\\s+([A-Za-z]+)\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR",
        "SF": "SOFR",
        "SOFR": "SOFR",
        "L": "LIBOR",
        "LIBOR": "LIBOR",
        "P": "PRIME",
        "PRIME": "PRIME",
        "E": "EURIBOR",
        "EURIBOR": "EURIBOR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Reference Rate and Spread\\s+(?:[A-Za-z]+\\s*\\+\\s*)?([0-9]+\\.?[0-9]*)\\s*%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "incl\\.?\\s+([0-9]+\\.?[0-9]*)\\s*%\\s*PIK",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate_all_in",
      "regex": "Interest Rate\\s+([0-9]+\\.?[0-9]*)\\s*%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "Maturity Date\\s+([0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4})",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "derivations": {
    "coupon_type": "floating_if_reference_rate_else_fixed"
  },
  "invariants": [
    {
      "name": "spread_vs_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    },
    {
      "name": "all_in_vs_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate_all_in",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_vs_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ],
  "required_fields": [
    "basis_spread",
    "interest_rate_all_in",
    "maturity_date"
  ]
}
