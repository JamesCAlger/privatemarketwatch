{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001837532",
  "entity_name": "Apollo Debt Solutions BDC",
  "version": 1,
  "author": "agentA2 sandbox proposal from bundle 0001837532_2025-12-31.json",
  "applies_to": {
    "regime": "flattened",
    "signature": "CATEGORY SECDEBT RATE REFRATE MAT",
    "_resolved_by": "harness resolve_applies_to (committed anchors)"
  },
  "available_identifier_datapoints": [
    "issuer",
    "investment_type",
    "reference_rate_type",
    "basis_spread",
    "pik_rate",
    "interest_rate_floor",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [
    "interest_rate",
    "interest_rate_all_in",
    "interest_rate_total",
    "interest_rate_cash_leg"
  ],
  "pik_convention": "additive",
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "Interest\\s+Rate\\s+(SONIA|SOFR|SF|LIBOR|EURIBOR|PRIME|S|L|P|E)\\s*\\+\\s*[0-9]",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SONIA": "SONIA",
        "SOFR": "SOFR",
        "SF": "SOFR",
        "S": "SOFR",
        "LIBOR": "LIBOR",
        "L": "LIBOR",
        "PRIME": "PRIME",
        "P": "PRIME",
        "EURIBOR": "EURIBOR",
        "E": "EURIBOR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Interest\\s+Rate\\s+(?:SONIA|SOFR|SF|LIBOR|EURIBOR|PRIME|S|L|P|E)\\s*\\+\\s*([0-9]{2,4})\\b(?!\\s*%)",
      "group": 1,
      "type": "bps"
    },
    {
      "field": "pik_rate",
      "regex": "(?:Cash\\s+plus,?\\s+|Includes\\s+)([0-9]+(?:\\.[0-9]+)?)\\s*%\\s*PIK",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate_floor",
      "regex": "([0-9]+(?:\\.[0-9]+)?)\\s*%\\s*Floor",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "Maturity\\s*Date\\s*([0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4})",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "derivations": {
    "coupon_type": "floating_if_reference_rate_else_fixed"
  },
  "invariants": [
    {
      "name": "spread_vs_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    },
    {
      "name": "maturity_vs_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "floating_has_reference",
      "kind": "implication",
      "if_present": "basis_spread",
      "then_present": "reference_rate_type"
    }
  ],
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "maturity_date"
  ]
}