{
  "cik": "0001905824",
  "schema": "agentA-rate-grammar.v1",
  "status": "ACTIVE",
  "available_identifier_datapoints": [
    "asset_class",
    "instrument_type",
    "industry",
    "issuer_or_borrower",
    "loan_or_security_description",
    "reference_rate_type",
    "basis_spread",
    "interest_rate",
    "pik_rate",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [],
  "pik_convention": "inclusive",
  "applies_to": {
    "regime": "flattened",
    "signature": "ASSETTYPE SECDEBT REFRATE RATE MAT"
  },
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "interest_rate",
    "maturity_date"
  ],
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "\\|\\s*([A-Z][A-Z0-9 -]{1,20})\\s*\\+\\s*\\d+(?:\\.\\d+)?\\s*%?",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR",
        "EURIBOR": "EURIBOR",
        "LIBOR": "LIBOR",
        "PRIME": "PRIME"
      }
    },
    {
      "field": "basis_spread",
      "regex": "\\|\\s*[A-Z][A-Z0-9 -]{1,20}\\s*\\+\\s*(\\d+(?:\\.\\d+)?)\\s*%?",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "\\|\\s*(\\d+(?:\\.\\d+)?)\\s*%\\s*\\|\\s*\\d{1,2}/\\d{1,2}/\\d{4}\\b",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "pik_rate",
      "regex": "\\((\\d+(?:\\.\\d+)?)\\s*%\\s*PIK\\)",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "\\|\\s*(?:\\d+(?:\\.\\d+)?\\s*%|0\\.\\d{3,})\\s*\\|\\s*(\\d{1,2}/\\d{1,2}/\\d{4})\\b",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "invariants": [
    {
      "name": "interest_rate_matches_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_date_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ]
}
