{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001772704",
  "entity_name": "Goldman Sachs Private Middle Market Credit II LLC",
  "status": "PROPOSED_RATE_GRAMMAR",
  "applies_to": {
    "regime": "flattened",
    "signature": "INVEST SECDEBT COUNTRY RATE REFRATE MAT"
  },
  "available_identifier_datapoints": [
    "issuer",
    "instrument_type",
    "country",
    "industry",
    "interest_rate",
    "reference_rate_type",
    "basis_spread",
    "pik_rate",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [
    "cash_leg",
    "interest_rate_floor"
  ],
  "required_fields": [
    "maturity_date"
  ],
  "pik_convention": "inclusive",
  "extractors": [
    {
      "field": "interest_rate",
      "regex": "Interest Rate\\s+([0-9]+(?:\\.[0-9]+)?)\\.?(?:\\s*)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "reference_rate_type",
      "regex": "Reference Rate and Spread\\s+([A-Z]{1,3})\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR",
        "SN": "SONIA",
        "L": "LIBOR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Reference Rate and Spread\\s+(?:[A-Z]{1,3}\\s*\\+\\s*)?([0-9]+(?:\\.[0-9]+)?)\\s*%?(?=\\s*(?:\\(|PIK|Maturity))",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "\\(?[Ii]ncl\\.\\s+([0-9]+(?:\\.[0-9]+)?)\\s*%\\s+PIK\\)?",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "Reference Rate and Spread\\s+(?:[A-Z]{1,3}\\s*\\+\\s*)?([0-9]+(?:\\.[0-9]+)?)\\s*%?\\s+PIK\\s+Maturity",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "Maturity\\s+([0-9]{1,2}/[0-9]{1,2}/(?:[0-9]{2}|[0-9]{4}))",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "derivations": [
    {
      "field": "coupon_type",
      "rule": "floating_if_reference_rate_type_present"
    }
  ],
  "invariants": [
    {
      "name": "maturity_matches_structured_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "reference_implies_spread",
      "kind": "implication",
      "if_present": "reference_rate_type",
      "then_present": "basis_spread"
    }
  ],
  "notes": [
    "Identifier strings explicitly embed Interest Rate, Reference Rate and Spread, optional PIK, and Maturity in the debt variants.",
    "Older samples use SECDEBT before RATE and sometimes omit spaces around S+6.00%; regexes are label based to cover both old and new eras.",
    "Optional PIK and interest-rate text are not required because several bundle samples omit those fields while retaining spread and maturity."
  ]
}
