{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001634452",
  "entity_name": "AB Private Credit Investors Corp",
  "report_date": "2025-12-31",
  "status": "PROPOSED",
  "available_identifier_datapoints": [
    "asset_region_or_category",
    "seniority_or_security_type",
    "issuer",
    "industry",
    "instrument_type",
    "stated_interest_rate",
    "reference_rate_type",
    "basis_spread",
    "floor_rate",
    "pik_rate",
    "maturity_date",
    "optional_tranche_marker"
  ],
  "unsupported_identifier_datapoints": [
    "commitment_amount",
    "principal_amount",
    "cost",
    "fair_value",
    "footnotes"
  ],
  "applies_to": {
    "regime": "flattened",
    "signature": "SECDEBT RATE MAT"
  },
  "dominant_signature": "SECDEBT RATE MAT",
  "extractors": [
    {
      "field": "interest_rate",
      "regex": "\\|\\s*(?P<interest_rate>[0-9]+(?:\\.[0-9]+)?)\\s*%\\s*\\(",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "reference_rate_type",
      "regex": "\\(\\s*(?P<reference_rate_type>S)\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "\\(\\s*S\\s*\\+\\s*(?P<basis_spread>[0-9]+(?:\\.[0-9]+)?)\\s*%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "floor_rate",
      "regex": ";\\s*(?P<floor_rate>[0-9]+(?:\\.[0-9]+)?)\\s*%\\s*Floor",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": ";\\s*(?P<pik_rate>[0-9]+(?:\\.[0-9]+)?)\\s*%\\s*PIK",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "\\|\\s*(?P<maturity_date>[0-9]{1,2}/[0-9]{1,2}/[0-9]{4})(?:\\s*\\||\\s*$)",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "maturity_date"
  ],
  "optional_fields": [
    "interest_rate",
    "floor_rate",
    "pik_rate",
    "optional_tranche_marker"
  ],
  "derivations": {
    "coupon_type": {
      "floating_when_present": "reference_rate_type"
    }
  },
  "pik_convention": "additive",
  "normalization_notes": [
    "Interest, spread, floor, and PIK values are embedded as displayed percentages and should be normalized from percent to decimal by the deterministic engine.",
    "basis_spread is represented as a displayed percent, not bps, in the identifier strings.",
    "Debt rows with S + spread are floating-rate rows; do not infer reference rates for equity/fund-interest rows.",
    "PIK is extracted only when explicitly present after the floor clause."
  ],
  "invariants": [
    {
      "name": "basis_spread_twin_agree",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread",
      "tolerance": 0.0001
    },
    {
      "name": "maturity_date_twin_agree",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ],
  "evidence": [
    {
      "accession_number": "0001193125-26-124450",
      "table_index": 51,
      "row_index": 27,
      "observation": "Debt row includes rate placeholder, S + spread, floor, PIK, and maturity in the source table."
    },
    {
      "accession_number": "0001193125-26-124450",
      "table_index": 52,
      "row_index": 21,
      "observation": "Debt row includes stated coupon, S + spread, floor, and maturity in the source table."
    }
  ]
}
