{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001784700",
  "entity_name": "Varagon Capital Corp",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "AFFIL REFRATE RATE MAT"
  },
  "available_identifier_datapoints": [
    "affiliation/control status",
    "asset class",
    "industry",
    "issuer/company",
    "investment type",
    "reference_rate_type",
    "basis_spread",
    "pik_rate",
    "interest_rate",
    "acquisition_date",
    "maturity_date",
    "tranche/index suffix"
  ],
  "unsupported_identifier_datapoints": [
    "interest_rate_floor",
    "interest_rate_cash_leg",
    "interest_rate_total"
  ],
  "pik_convention": "additive",
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "interest_rate",
    "maturity_date"
  ],
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "Reference Rate and Spread\\s+([A-Za-z]+)\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Reference Rate and Spread\\s+[A-Za-z]+\\s*\\+\\s*([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "pik_rate",
      "regex": "\\(([0-9]+(?:\\.[0-9]+)?)%\\s+PIK\\)",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "Interest Rate\\s+([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "Maturity\\s+([0-9]{1,2}/[0-9]{1,2}/(?:[0-9]{2}|[0-9]{4}))",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "invariants": [
    {
      "name": "reference_rate_implies_spread",
      "kind": "implication",
      "if_present": "reference_rate_type",
      "then_present": "basis_spread"
    },
    {
      "name": "interest_rate_implies_maturity",
      "kind": "implication",
      "if_present": "interest_rate",
      "then_present": "maturity_date"
    }
  ],
  "notes": [
    "Dominant bundled signature AFFIL REFRATE RATE MAT embeds SOFR reference, spread percent, interest rate percent, optional PIK percent, and maturity date.",
    "Older identifiers omit spaces around SOFR+ and may use two-digit years; regexes cover both SOFR + 2.50% and SOFR+2.50%, and M/D/YYYY or MM/DD/YY maturity dates.",
    "AFFIL RATE MAT samples embed interest rate and maturity only; they do not carry reference rate or spread, so they are not included in the required dominant floating-rate grammar."
  ]
}
