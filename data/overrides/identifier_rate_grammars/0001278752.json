    },
    {
      "field": "basis_spread",
      "regex": "(?:SOFR|SON|CORRA|SF|LIBOR|L|PRIME|P|EURIBOR|E)\\s*\\+\\s*([0-9]{2,4})\\b(?!\\s*%)",
      "group": 1,
      "type": "bps"
    },
    {
      "field": "pik_rate",
      "regex": "(?:Cash\\s+plus\\s+)?([0-9]+\\.?[0-9]*)\\s*%\\s*PIK",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate_floor",
      "regex": "([0-9]+\\.?[0-9]*)\\s*%\\s*Floor",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "(?:Maturity(?:\\s+Date)?\\s+)?([0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4})\\s*$",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "derivations": {
    "coupon_type": "floating_if_reference_rate_else_fixed"
  },
  "invariants": [
    {"name": "spread_vs_twin", "kind": "pct_agree", "parsed": "basis_spread", "twin": "basis_spread"},
    {"name": "maturity_vs_twin", "kind": "date_agree", "parsed": "maturity_date", "twin": "maturity_date"},
    {"name": "floating_has_reference", "kind": "implication", "if_present": "basis_spread", "then_present": "reference_rate_type"}
