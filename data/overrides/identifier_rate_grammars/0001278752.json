  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "(SOFR|SON|CORRA|SF|LIBOR|L|PRIME|P|EURIBOR|E)\\s*\\+\\s*[0-9]",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SF": "SOFR",
        "SOFR": "SOFR",
        "SON": "SON",
        "CORRA": "CORRA",
        "L": "LIBOR",
        "LIBOR": "LIBOR",
        "P": "PRIME",
        "PRIME": "PRIME",
        "E": "EURIBOR",
        "EURIBOR": "EURIBOR"
