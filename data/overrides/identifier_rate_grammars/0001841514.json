{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001841514",
  "applies_to": {
    "regime": "flattened",
    "signature": "REFRATE RATE MAT"
  },
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "(?i)Spread\\s+Above\\s+Index\\s+(SOFR|L)\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR",
        "L": "LIBOR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "(?i)Spread\\s+Above\\s+Index\\s+(?:SOFR|L)\\s*\\+\\s*(\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate_floor",
      "regex": "(?i)\\((\\d+(?:\\.\\d+)?)%\\s*floor\\)",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "pik_rate",
      "regex": "(?i)\\+\\s*(\\d+(?:\\.\\d+)?)%\\s*PIK",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "(?i)Interest\\s+rate\\s+(\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "(?i)Maturity\\s+Date\\s+(\\d{1,2}/\\d{1,2}/\\d{4})",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "interest_rate",
    "maturity_date"
  ],
  "pik_convention": "additive",
  "invariants": [
    {
      "name": "interest_rate_matches_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_date_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ]
}
