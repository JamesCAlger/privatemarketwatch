{
  "schema": "agentA-rate-grammar.v1",
  "cik": "0001383414",
  "entity_name": "PENNANTPARK INVESTMENT CORP",
  "regime": "flattened",
  "applies_to": {
    "regime": "flattened",
    "signature": "AFFIL SECDEBT MAT RATE REFRATE"
  },
  "available_identifier_datapoints": [
    "issuer",
    "instrument_type",
    "asset_type_or_tranche",
    "industry",
    "interest_rate",
    "pik_rate",
    "reference_rate_type",
    "basis_spread",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [
    "interest_rate_floor",
    "interest_rate_cash_leg"
  ],
  "required_fields": [
    "interest_rate"
  ],
  "pik_convention": "inclusive",
  "extractors": [
    {
      "field": "maturity_date",
      "regex": "\\bMaturity\\s+(\\d{1,2}/\\d{1,2}/\\d{2,4})\\b",
      "group": 1,
      "type": "date_mdy"
    },
    {
      "field": "interest_rate",
      "regex": "\\b(?:Current\\s+)?Coupon\\s+(\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "\\bPIK\\s+(\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "reference_rate_type",
      "regex": "\\b(?:Basis Point Spread Above Index\\s+)?(SOFR|\\dM\\s+L|L)\\+\\d+\\b",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR",
        "L": "LIBOR",
        "1M L": "LIBOR",
        "3M L": "LIBOR",
        "6M L": "LIBOR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "\\b(?:Basis Point Spread Above Index\\s+)?(?:SOFR|\\dM\\s+L|L)\\+(\\d+)\\b",
      "group": 1,
      "type": "bps"
    }
  ],
  "derivations": [
    {
      "field": "coupon_type",
      "rule": "floating_iff_reference_rate_type_present"
    }
  ],
  "invariants": [
    {
      "name": "coupon_matches_structured_twin_when_present",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_matches_structured_twin_when_present",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "spread_requires_reference_rate",
      "kind": "implication",
      "if_present": "basis_spread",
      "then_present": "reference_rate_type"
    }
  ],
  "notes": [
    "Identifier strings across 2023-2025 embed Maturity dates, Current Coupon/Coupon percentages, optional PIK rates, and SOFR/LIBOR spread tokens.",
    "Some bundle twins appear mis-binned versus identifiers, so invariants are advisory for deterministic screening rather than hand-fitting malformed samples."
  ]
}
