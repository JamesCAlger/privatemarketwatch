{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0002028686",
  "entity_name": "SL Investment Fund II LLC",
  "report_date": "2025-12-31",
  "status": "PROPOSED",
  "available_identifier_datapoints": [
    "issuer",
    "investment_type",
    "tranche_or_index",
    "reference_rate_type",
    "basis_spread",
    "interest_rate",
    "pik_rate",
    "maturity_date",
    "acquisition_date"
  ],
  "unsupported_identifier_datapoints": [
    "floor_rate",
    "cash_leg_rate",
    "all_in_total_rate"
  ],
  "not_applicable_reason": null,
  "applies_to": {
    "regime": "flattened",
    "report_dates": [
      "2024-12-31",
      "2025-03-31",
      "2025-06-30",
      "2025-09-30",
      "2025-12-31",
      "2026-03-31"
    ],
    "signature": "SECDEBT AFFIL REFRATE RATE MAT"
  },
  "dominant_signature": "SECDEBT AFFIL REFRATE RATE MAT",
  "coverage_basis": {
    "dominant_variant_count": 573,
    "dominant_variant_pct": 57.9,
    "rate_embed_pct": 58.3,
    "evidence": [
      {
        "accession_number": "0001193125-26-223928",
        "observation": "Dominant debt samples contain Reference Rate and Spread S + 5.00%, optional '(incl. 2.75% PIK)', Interest Rate 8.67%, and Maturity Date 2/2/2032."
      },
      {
        "accession_number": "0001193125-26-091861",
        "observation": "Older-format sample omits the explicit S + prefix and carries 'Reference Rate and Spread 5.00% (incl. 2.75% PIK)', so basis_spread must allow both prefixed and bare spread forms."
      }
    ]
  },
  "pik_convention": "inclusive",
  "required_fields": [
    "basis_spread",
    "interest_rate",
    "maturity_date"
  ],
  "optional_fields": [
    "reference_rate_type",
    "pik_rate"
  ],
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "Reference Rate and Spread\\s+(S)\\s*\\+\\s*[0-9]+(?:\\.[0-9]+)?%",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Reference Rate and Spread\\s+(?:S\\s*\\+\\s*)?([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate",
      "regex": "Interest Rate\\s+([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "\\(incl\\.\\s+([0-9]+(?:\\.[0-9]+)?)%\\s+PIK\\)",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "Maturity Date\\s+([0-9]{1,2}/[0-9]{1,2}/[0-9]{4})",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "derivations": {
    "coupon_type": {
      "floating_if_present": "reference_rate_type",
      "fixed_otherwise": true
    }
  },
  "invariants": [
    {
      "name": "basis_spread_matches_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    },
    {
      "name": "interest_rate_matches_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_date_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ],
  "notes": [
    "The grammar extracts only datapoints present in investment_identifier strings, not SOI-only columns.",
    "reference_rate_type is optional because one sampled debt identifier carries a bare spread without the S + token.",
    "PIK is optional and is not included in required_fields."
  ]
}
