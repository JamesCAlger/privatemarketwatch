{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001370755",
  "entity_name": "BlackRock TCP Capital Corp.",
  "report_date": "2025-12-31",
  "status": "PROPOSED",
  "available_identifier_datapoints": [
    "issuer",
    "industry",
    "security_type",
    "instrument_type",
    "tranche",
    "reference_rate",
    "reference_rate_tenor",
    "floor_rate",
    "spread_rate",
    "cash_pik_split",
    "pik_rate",
    "total_coupon",
    "maturity_date",
    "expiration_date"
  ],
  "unsupported_identifier_datapoints": [],
  "applies_to": {
    "regime": "flattened",
    "signature": "DEBT REFRATE RATE MAT"
  },
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "interest_rate_total",
    "maturity_date"
  ],
  "pik_convention": "additive",
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "\\bRef\\s+(SOFR|LIBOR|Prime|Fixed)\\s*(?:\\([A-Z]\\))?",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR",
        "LIBOR": "LIBOR",
        "Prime": "PRIME",
        "Fixed": "FIXED"
      }
    },
    {
      "field": "basis_spread",
      "regex": "\\bSpread\\s+([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate_total",
      "regex": "\\bTotal Coupon\\s+([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "pik_rate",
      "regex": "\\b(?:Cash\\s*\\+\\s*)?([0-9]+(?:\\.[0-9]+)?)%\\s*PIK%?\\b",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "\\bMaturity\\s+([0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4})",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "invariants": [
    {
      "name": "total_coupon_matches_structured_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate_total",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_matches_structured_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "spread_implies_reference_rate",
      "kind": "implication",
      "if_present": "basis_spread",
      "then_present": "reference_rate_type"
    }
  ]
}
