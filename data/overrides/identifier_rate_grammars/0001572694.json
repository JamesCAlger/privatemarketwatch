{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001572694",
  "entity_name": "Goldman Sachs BDC, Inc.",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "SECDEBT ASSETTYPE RATE REFRATE MAT"
  },
  "available_identifier_datapoints": [
    "issuer",
    "country",
    "asset_class",
    "instrument_type",
    "industry",
    "interest_rate",
    "reference_rate_type",
    "basis_spread",
    "pik_rate",
    "maturity_date",
    "initial_acquisition_date",
    "fair_value_percentage_markers"
  ],
  "unsupported_identifier_datapoints": [
    "cash_leg_rate",
    "interest_rate_floor",
    "commitment_amount",
    "principal_amount",
    "fair_value_amount"
  ],
  "required_fields": [
    "interest_rate",
    "maturity_date"
  ],
  "pik_convention": "inclusive",
  "extractors": [
    {
      "field": "interest_rate",
      "regex": "Interest Rate\\s+([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "reference_rate_type",
      "regex": "Reference Rate and Spread\\s+([A-Z]{1,3})\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR",
        "SN": "SONIA"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Reference Rate and Spread\\s+[A-Z]{1,3}\\s*\\+\\s*([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "(?:\\(\\s*[Ii]ncl\\.?\\s*|\\+\\s*)([0-9]+(?:\\.[0-9]+)?)\\s*%\\s*PIK",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "Maturity\\s+([0-9]{1,2}/[0-9]{1,2}/[0-9]{2})",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "invariants": [
    {
      "name": "interest_rate_matches_structured_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_date_matches_structured_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "reference_code_implies_spread",
      "kind": "implication",
      "if_present": "reference_rate_type",
      "then_present": "basis_spread"
    }
  ]
}
