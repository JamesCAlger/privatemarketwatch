{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001726548",
  "entity_name": "BC Partners Lending Corp",
  "report_date": "2025-12-31",
  "status": "PROPOSED",
  "dominant_signature": "RATE REFRATE MAT",
  "applies_to": {
    "regime": "flattened",
    "signature": "RATE REFRATE MAT",
    "signatures": [
      "RATE REFRATE MAT",
      "RATE",
      "RATE MAT"
    ]
  },
  "available_identifier_datapoints": [
    "issuer",
    "instrument_type",
    "industry",
    "interest_rate",
    "reference_rate_type",
    "basis_spread",
    "pik_rate",
    "floor",
    "maturity_date",
    "tranche_suffix"
  ],
  "unsupported_identifier_datapoints": [
    "cash_leg",
    "commitment_amount",
    "par_or_shares",
    "amortized_cost",
    "fair_value",
    "footnotes"
  ],
  "not_applicable_reason": null,
  "pik_convention": "additive",
  "required_fields": [
    "interest_rate"
  ],
  "extractors": [
    {
      "field": "interest_rate",
      "regex": "Interest Rate\\s+(?P<interest_rate>[0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "reference_rate_type",
      "regex": "Reference Rate and Spread\\s+(?P<reference_rate_type>[A-Z])\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "S": "SOFR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Reference Rate and Spread\\s+[A-Z]\\s*\\+\\s*(?P<basis_spread>[0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "(?:,\\s*)?(?P<pik_rate>[0-9]+(?:\\.[0-9]+)?)%\\s+PIK",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "floor",
      "regex": "Floor\\s+(?P<floor>[0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "Maturity(?:\\s+Date)?\\s+(?P<maturity_date>[0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4})",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "derivations": {
    "coupon_type": {
      "rule": "floating_if_reference_rate_type_present_else_fixed"
    }
  },
  "invariants": [
    {
      "name": "interest_rate_matches_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate",
      "tolerance": 0.0001
    },
    {
      "name": "basis_spread_matches_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread",
      "tolerance": 0.0001
    },
    {
      "name": "pik_rate_matches_twin",
      "kind": "pct_agree",
      "parsed": "pik_rate",
      "twin": "pik_rate",
      "tolerance": 0.0001
    },
    {
      "name": "maturity_date_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ],
  "evidence": [
    {
      "type": "bundle_sample",
      "signature": "RATE REFRATE MAT",
      "observation": "Dominant loan samples embed Interest Rate, Reference Rate and Spread, optional PIK, Floor, and Maturity in the investment_identifier string."
    },
    {
      "type": "roam",
      "table_index": 38,
      "row_index": 1,
      "observation": "SOI header has Investment, Industry, Interest Rate, Reference Rate and Spread, Floor, and Maturity columns."
    },
    {
      "type": "roam",
      "table_index": 38,
      "row_index": 12,
      "observation": "AMCP PET row shows Interest Rate 10.65%, Reference Rate and Spread S + 7.00%, 3% PIK, Floor 1.00%, and Maturity 1/4/2028."
    },
    {
      "type": "roam",
      "table_index": 38,
      "row_index": 14,
      "observation": "American Academy row shows Interest Rate 13.40%, Reference Rate and Spread S + 9.75%, 5.25% PIK, Floor 1.00%, and Maturity 6/30/2027."
    }
  ],
  "residual_risk": "The RATE-only equity/other signature is mixed: some identifiers contain an Interest Rate and Floor, while several carry only issuer/type/industry text. The grammar therefore requires only interest_rate for rate-bearing parses and keeps reference, spread, PIK, floor, and maturity optional."
}
