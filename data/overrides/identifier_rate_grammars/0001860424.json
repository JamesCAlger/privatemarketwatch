{
  "schema": "agentA-rate-grammar.v1",
  "cik": "0001860424",
  "entity_name": "Onex Direct Lending BDC Fund",
  "report_date": "2025-12-31",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "AFFIL REFRATE RATE MAT"
  },
  "available_identifier_datapoints": [
    "affiliation_bucket",
    "asset_class",
    "industry",
    "issuer",
    "instrument_type",
    "reference_rate_type",
    "reference_rate_tenor",
    "basis_spread",
    "floor",
    "interest_rate",
    "pik_rate",
    "initial_acquisition_date",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [],
  "pik_convention": "inclusive",
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "Reference Rate and Spread\\s+\\d+M\\s+(SOFR)\\s*\\+\\s*\\d+(?:\\.\\d+)?%",
      "group": 1,
      "map": {
        "SOFR": "SOFR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Reference Rate and Spread\\s+\\d+M\\s+SOFR\\s*\\+\\s*(\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "floor",
      "regex": "Floor\\s+(\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate",
      "regex": "Interest Rate\\s+(\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "Interest Rate\\s+\\d+(?:\\.\\d+)?%\\s*\\(\\s*(\\d+(?:\\.\\d+)?)%\\s+PIK\\s*\\)",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "Maturity Date\\s+(\\d{1,2}/\\d{1,2}/\\d{4})",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "derivations": {
    "coupon_type": {
      "floating_when": "reference_rate_type_present",
      "fixed_when": "reference_rate_type_absent_and_interest_rate_present"
    }
  },
  "required_fields": [
    "interest_rate",
    "maturity_date"
  ],
  "invariants": [
    {
      "name": "interest_rate_matches_twin",
      "kind": "pct_agree",
      "field": "interest_rate",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_date_matches_twin",
      "kind": "date_agree",
      "field": "maturity_date",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ],
  "evidence": [
    {
      "source": "bundle top variant AFFIL REFRATE RATE MAT",
      "observation": "85 of 93 identifiers embed Reference Rate and Spread, Floor, Interest Rate, optional parenthetical PIK, Initial Acquisition Date, and Maturity Date."
    },
    {
      "source": "evidence_cli roam Reference Rate and Spread,Interest Rate,Maturity Date",
      "observation": "Tables 48-51 and 53-56 expose SOI headers matching the flattened identifier segments."
    },
    {
      "source": "evidence_cli roam PIK,Floor,Initial Acquisition Date",
      "observation": "Debt rows show examples such as Interest Rate 9.42% (2.75% PIK), confirming PIK is embedded on some identifiers but optional."
    }
  ],
  "notes": [
    "The AFFIL MAT equity variant has issuer, equity instrument type, and initial acquisition date but no rate or maturity datapoints; rate extraction is expected to be inapplicable to those rows.",
    "One sample twin for IMB Midco Term Loan A reports basis_spread 0.05 while the identifier says 6.00%; this proposal follows the identifier text as required by the A2 contract."
  ]
}
