{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001834543",
  "entity_name": "BlackRock Direct Lending Corp.",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "SECDEBT RATE MAT"
  },
  "available_identifier_datapoints": [
    "asset_class_or_section",
    "industry",
    "issuer",
    "instrument_type",
    "reference_rate_type",
    "interest_rate_floor",
    "basis_spread",
    "pik_rate",
    "interest_rate_total",
    "maturity_date",
    "warrant_expiration_date",
    "acquisition_date"
  ],
  "unsupported_identifier_datapoints": [
    "principal_amount",
    "cost",
    "fair_value"
  ],
  "pik_convention": "additive",
  "required_fields": [
    "maturity_date"
  ],
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "\\bRef\\s+(SOFR\\([MQ]\\)|LIBOR\\([MQ]\\)|Prime)\\b",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR(M)": "SOFR",
        "SOFR(Q)": "SOFR",
        "LIBOR(M)": "LIBOR",
        "LIBOR(Q)": "LIBOR",
        "Prime": "PRIME"
      }
    },
    {
      "field": "interest_rate_floor",
      "regex": "\\bFloor\\s+(\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "basis_spread",
      "regex": "\\bSpread\\s+(\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "pik_rate",
      "regex": "(?:Cash\\s*\\+\\s*)?(\\d+(?:\\.\\d+)?)%\\s+PIK\\b",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "\\bTotal Coupon\\s+(\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "\\bMaturity(?:\\s+Date)?\\s+(\\d{1,2}/\\d{1,2}/\\d{4})\\b",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "invariants": [
    {
      "name": "total_coupon_agrees_with_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_agrees_with_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "reference_implies_coupon",
      "kind": "implication",
      "if_present": "reference_rate_type",
      "then_present": "interest_rate"
    }
  ]
}
