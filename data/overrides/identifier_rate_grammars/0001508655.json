{
  "schema": "agentA-rate-grammar.v1",
  "cik": "0001508655",
  "entity_name": "Sixth Street Specialty Lending, Inc.",
  "regime": "flattened",
  "status": "APPLICABLE_RATE_GRAMMAR",
  "available_identifier_datapoints": [
    "asset_class",
    "industry",
    "issuer",
    "instrument_type",
    "par_amount",
    "maturity_month_year",
    "initial_acquisition_date",
    "reference_rate_type",
    "basis_spread",
    "interest_rate_all_in",
    "pik_rate",
    "ownership_percent"
  ],
  "unsupported_identifier_datapoints": [
    "cash_interest_leg",
    "interest_rate_floor",
    "explicit_total_rate_formula"
  ],
  "applies_to": {
    "regime": "flattened",
    "signature": "DEBTINV INDUSTRY ASSETTYPE MAT REFRATE RATE"
  },
  "pik_convention": "inclusive",
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "interest_rate_all_in"
  ],
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "Reference Rate and Spread\\s+(SOFR|S|E|L)\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR",
        "S": "SOFR",
        "E": "EURIBOR",
        "L": "LIBOR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Reference Rate and Spread\\s+(?:SOFR|S|E|L)\\s*\\+\\s*(\\d{1,2}(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate_all_in",
      "regex": "Interest Rate\\s+(\\d{1,2}(?:\\.\\d+)?)(?:%)?\\b",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "pik_rate",
      "regex": "\\(\\s*(?:incl\\.\\s*)?(\\d{1,2}(?:\\.\\d+)?)\\s*%\\s*PIK\\s*\\)?",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "\\bdue\\s+(\\d{1,2}/\\d{4})\\b",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "derivations": {
    "coupon_type": "floating_if_reference_rate_else_fixed"
  },
  "invariants": [
    {
      "name": "interest_rate_matches_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate_all_in",
      "twin": "interest_rate"
    },
    {
      "name": "basis_spread_matches_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    },
    {
      "name": "reference_implies_spread",
      "kind": "implication",
      "if_present": "reference_rate_type",
      "then_present": "basis_spread"
    }
  ]
}
