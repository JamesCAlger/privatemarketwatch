{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001504619",
  "applies_to": {
    "regime": "flattened",
    "signature": "AFFIL SECDEBT MAT RATE REFRATE"
  },
  "required_fields": [
    "maturity_date"
  ],
  "pik_convention": "inclusive",
  "available_identifier_datapoints": [
    "issuer",
    "affiliation/category",
    "instrument type",
    "maturity_date",
    "interest_rate",
    "pik_rate",
    "basis_spread",
    "reference_rate_type",
    "industry"
  ],
  "unsupported_identifier_datapoints": [
    "interest_rate_floor",
    "cash_leg_rate",
    "all_in_rate_total"
  ],
  "extractors": [
    {
      "field": "maturity_date",
      "regex": "(?i)\\bMaturity\\s+(\\d{1,2}/\\d{1,2}/\\d{4})",
      "group": 1,
      "type": "date_mdy"
    },
    {
      "field": "interest_rate",
      "regex": "(?i)Current Coupon\\s+(?:PIK\\s*)?\\(?(\\d+(?:\\.\\d+)?)%\\)?",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "(?i)\\(PIK\\s+(\\d+(?:\\.\\d+)?)%\\)",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "basis_spread",
      "regex": "(?i)Basis Point Spread Above Index\\s+(?:\\d+\\s*M\\s*)?(?:L|SOFR|S\\s*O\\s*F\\s*R)\\s*\\+\\s*(\\d{2,4})",
      "group": 1,
      "type": "bps"
    },
    {
      "field": "reference_rate_type",
      "regex": "(?i)Basis Point Spread Above Index\\s+(?:\\d+\\s*M\\s*)?(L|SOFR|S\\s*O\\s*F\\s*R)",
      "group": 1,
      "type": "ref_code",
      "map": {
        "L": "LIBOR",
        "SOFR": "SOFR",
        "S O F R": "SOFR"
      }
    }
  ],
  "invariants": [
    {
      "name": "maturity_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "coupon_matches_twin_when_present",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    }
  ]
}
