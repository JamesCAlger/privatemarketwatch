{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0002011498",
  "entity_name": "AGL Private Credit Income Fund",
  "status": "APPLICABLE_RATE_GRAMMAR",
  "applies_to": {
    "regime": "flattened",
    "signature": "AFFIL SECDEBT ASSETTYPE REFRATE RATE MAT"
  },
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "maturity_date"
  ],
  "pik_convention": "additive",
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "Reference Rate and Spread\\s+([A-Z][A-Z0-9 -]*?)\\s*\\+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Reference Rate and Spread\\s+[A-Z][A-Z0-9 -]*?\\s*\\+\\s*([0-9]+(?:\\.[0-9]+)?)%?",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "interest_rate",
      "regex": "All In Rate\\s+([0-9]+(?:\\.[0-9]+)?)%",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "cash\\s*/\\s*([0-9]+(?:\\.[0-9]+)?)%\\s*PIK",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "Maturity Date\\s+(\\d{1,2}/\\d{1,2}/\\d{4})",
      "group": 1,
      "type": "date_mdy"
    }
  ],
  "invariants": [
    {
      "name": "basis_spread_matches_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    },
    {
      "name": "maturity_date_matches_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    }
  ],
  "available_identifier_datapoints": [
    "issuer",
    "instrument_type",
    "asset_class",
    "industry",
    "affiliation_status",
    "reference_rate_type",
    "basis_spread",
    "interest_rate_all_in",
    "pik_rate",
    "acquisition_date",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [
    "acquisition_date"
  ],
  "notes": "Identifiers embed SOFR reference-rate spreads, optional all-in rates, optional cash/PIK split, and maturity dates across old and new ordering. Some structured twins have interest_rate=0.0 or apparent mismatches where the identifier lacks All In Rate; interest_rate is therefore extracted when present but not required."
}
