{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001911321",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "SECDEBT REFRATE RATE MAT"
  },
  "available_identifier_datapoints": [
    "issuer",
    "instrument_type",
    "original_purchase_date",
    "reference_rate_type",
    "basis_spread",
    "pik_rate",
    "interest_rate",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [
    "industry",
    "fair_value",
    "principal_amount",
    "cost"
  ],
  "required_fields": [
    "interest_rate",
    "maturity_date"
  ],
  "pik_convention": "inclusive",
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "\\b(SOFR|LIBOR|S|E)(?:\\s*Spread|\\+)",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR",
        "LIBOR": "LIBOR",
        "S": "SOFR",
        "E": "EURIBOR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "\\b(?:SOFR|LIBOR|S|E)(?:\\s*Spread\\s*S?\\+?|\\+)\\s*([0-9]+(?:\\.[0-9]+)?)\\s*%?",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "pik_rate",
      "regex": "(?:/\\s*|\\s)(\\.?[0-9]+(?:\\.[0-9]+)?)\\s*%?\\s*PIK\\b",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "\\bInterest Rate\\s*([0-9]+(?:\\.[0-9]+)?)\\s*%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "\\b(?:Due|Maturity Date)\\s*([0-9]{1,2}/[0-9]{1,2}/[0-9]{4})\\b",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "invariants": [
    {
      "name": "interest_rate_matches_structured_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "maturity_date_matches_structured_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "pik_implies_interest_rate",
      "kind": "implication",
      "if_present": "pik_rate",
      "then_present": "interest_rate"
    }
  ]
}
