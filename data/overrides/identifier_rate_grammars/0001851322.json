{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001851322",
  "entity_name": "North Haven Private Income Fund LLC",
  "version": 3,
  "applies_to": {"regime": "flattened", "signature": "AFFIL DEBT REFRATE RATE MAT"},
  "pik_convention": "inclusive",
  "extractors": [
    {"field": "reference_rate_type", "regex": "Reference Rate\\s*(?:&|and)\\s*Spread\\s+(SOFR|SF|S|LIBOR|EURIBOR|E|Prime Rate|Prime|P)\\b", "group": 1, "type": "ref_code", "map": {"SOFR": "SOFR", "SF": "SOFR", "S": "SOFR", "LIBOR": "LIBOR", "EURIBOR": "EURIBOR", "E": "EURIBOR", "PRIME RATE": "PRIME", "PRIME": "PRIME", "P": "PRIME"}},
    {"field": "basis_spread", "regex": "Reference Rate\\s*(?:&|and)\\s*Spread\\s+(?:SOFR|SF|S|LIBOR|EURIBOR|E|Prime Rate|Prime|P)\\s*\\+\\s*([0-9]+\\.?[0-9]*)\\s*%", "group": 1, "type": "pct"},
    {"field": "pik_rate", "regex": "(?:\\(\\s*(?:incl\\.?\\s*)?|\\+\\s*)([0-9]+\\.?[0-9]*)\\s*%\\s*PIK(?:\\s*\\)|\\s+Interest Rate)", "group": 1, "type": "pct"},
    {"field": "interest_rate_all_in", "regex": "Interest Rate\\s+([0-9]+\\.?[0-9]*)\\s*%", "group": 1, "type": "pct"},
    {"field": "maturity_date", "regex": "Maturity Date\\s+([0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4})", "group": 1, "type": "date_mdy"}
  ],
  "derivations": {"coupon_type": "floating_if_reference_rate_else_fixed"},
  "invariants": [
    {"name": "spread_vs_twin", "kind": "pct_agree", "parsed": "basis_spread", "twin": "basis_spread"},
    {"name": "all_in_vs_twin", "kind": "pct_agree", "parsed": "interest_rate_all_in", "twin": "interest_rate"},
    {"name": "maturity_vs_twin", "kind": "date_agree", "parsed": "maturity_date", "twin": "maturity_date"},
    {"name": "floating_has_reference", "kind": "implication", "if_present": "basis_spread", "then_present": "reference_rate_type"}
  ],
  "required_fields": ["reference_rate_type", "basis_spread", "maturity_date"],
  "available_identifier_datapoints": ["issuer", "instrument type", "tranche/index number", "reference rate code", "basis spread", "optional PIK rate", "optional all-in interest rate", "maturity date", "acquisition date on equity identifiers"],
  "unsupported_identifier_datapoints": ["reference index value", "cash interest leg when not explicitly stated", "fair value", "principal amount"]
}
