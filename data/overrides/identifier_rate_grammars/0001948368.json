{
  "schema_version": "agentA-rate-grammar.v1",
  "cik": "0001948368",
  "status": "PROPOSED",
  "applies_to": {
    "regime": "flattened",
    "signature": "TOTAL SECDEBT RATE REFRATE MAT"
  },
  "extractors": [
    {"field": "interest_rate", "regex": "Interest Rate\\s+([0-9]+(?:\\.[0-9]+)?)%?", "group": 1, "type": "pct", "map": {}},
    {"field": "reference_rate_type", "regex": "Reference Rate and Spread\\s+([A-Za-z]+)\\s*\\+", "group": 1, "type": "ref_code", "map": {"S": "SOFR"}},
    {"field": "basis_spread", "regex": "Reference Rate and Spread\\s+[A-Za-z]+\\s*\\+\\s*([0-9]+(?:\\.[0-9]+)?)%", "group": 1, "type": "pct", "map": {}},
    {"field": "pik_rate", "regex": "\\(Incl\\.?\\s*([0-9]+(?:\\.[0-9]+)?)%\\s+PIK\\)", "group": 1, "type": "pct", "map": {}},
    {"field": "maturity_date", "regex": "Maturity\\s+(\\d{1,2}/\\d{1,2}/(?:\\d{2}|\\d{4}))", "group": 1, "type": "date_mdy", "map": {}}
  ],
  "required_fields": ["basis_spread", "reference_rate_type", "maturity_date"],
  "pik_convention": "inclusive",
  "derivations": {"coupon_type": "floating_iff_reference"},
  "invariants": [
    {"name": "maturity_matches_twin", "kind": "date_agree", "parsed": "maturity_date", "twin": "maturity_date"}
  ],
  "available_identifier_datapoints": ["issuer", "instrument_type", "tranche_index", "reference_rate_type", "basis_spread", "interest_rate", "pik_rate", "maturity_date"],
  "unsupported_identifier_datapoints": ["interest_rate_floor", "interest_rate_cash_leg"]
}
