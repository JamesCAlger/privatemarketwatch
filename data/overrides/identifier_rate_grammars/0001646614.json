{
  "schema": "agentA-rate-grammar.v1",
  "cik": "0001646614",
  "applies_to": {
    "regime": "flattened",
    "signature": "AFFIL RATE MAT"
  },
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "(?:^|[, ]+)(BBSY|SONIA|[SCEPL])\\+\\s*\\d+(?:\\.\\d+)?%",
      "group": 1,
      "type": "ref_code",
      "map": {"S": "SOFR", "C": "CORRA", "E": "EURIBOR", "P": "PRIME", "L": "LIBOR", "BBSY": "BBSY", "SONIA": "SONIA"}
    },
    {
      "field": "basis_spread",
      "regex": "(?:^|[, ]+)(?:BBSY|SONIA|[SCEPL])\\+\\s*(\\d+(?:\\.\\d+)?)%",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "(?:Interest Rate|(?<!Interest )Rate)\\s+(\\.?\\d+(?:\\.\\d+)?)\\s*%?(?=,?\\s+Original Acquisition Date)",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "pik_rate",
      "regex": "\\((?:[A-Z]+\\+)?(\\d+(?:\\.\\d+)?)% PIK\\)",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "Maturity Date\\s+(\\d{1,2}/\\d{1,2}/\\d{4})",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "required_fields": ["interest_rate", "maturity_date"],
  "pik_convention": "inclusive",
  "derivations": {"coupon_type": "floating_iff_reference"},
  "invariants": [
    {"name": "maturity_matches_twin", "kind": "date_agree", "parsed": "maturity_date", "twin": "maturity_date"}
  ]
}
