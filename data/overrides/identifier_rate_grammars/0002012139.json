{
  "version": "agentA-rate-grammar.v1",
  "cik": "0002012139",
  "entity_name": "Fortress Private Lending Fund",
  "status": "ACTIVE",
  "applies_to": {
    "regime": "flattened",
    "signature": "AFFIL REFRATE RATE MAT"
  },
  "available_identifier_datapoints": [
    "issuer",
    "industry",
    "affiliation_status",
    "investment_category",
    "instrument_type",
    "reference_rate_type",
    "basis_spread",
    "interest_rate",
    "maturity_date"
  ],
  "unsupported_identifier_datapoints": [
    "pik_rate",
    "interest_rate_floor",
    "interest_rate_cash_leg"
  ],
  "required_fields": [
    "reference_rate_type",
    "basis_spread",
    "interest_rate",
    "maturity_date"
  ],
  "extractors": [
    {
      "field": "reference_rate_type",
      "regex": "Reference Rate and Spread\\s+([A-Z][A-Z0-9-]*)\\+\\d+",
      "group": 1,
      "type": "ref_code",
      "map": {
        "SOFR": "SOFR",
        "EURIBOR": "EURIBOR"
      }
    },
    {
      "field": "basis_spread",
      "regex": "Reference Rate and Spread\\s+[A-Z][A-Z0-9-]*\\+(\\d+)",
      "group": 1,
      "type": "bps",
      "map": {}
    },
    {
      "field": "interest_rate",
      "regex": "Interest Rate\\s+(\\d+(?:\\.\\d+)?)%?",
      "group": 1,
      "type": "pct",
      "map": {}
    },
    {
      "field": "maturity_date",
      "regex": "Maturity Date\\s+(\\d{1,2}/\\d{1,2}/\\d{4})",
      "group": 1,
      "type": "date_mdy",
      "map": {}
    }
  ],
  "derivations": [
    {
      "field": "coupon_type",
      "value": "floating",
      "when_present": "reference_rate_type"
    }
  ],
  "pik_convention": null,
  "invariants": [
    {
      "name": "interest_rate_matches_structured_twin",
      "kind": "pct_agree",
      "parsed": "interest_rate",
      "twin": "interest_rate"
    },
    {
      "name": "basis_spread_matches_structured_twin",
      "kind": "pct_agree",
      "parsed": "basis_spread",
      "twin": "basis_spread"
    },
    {
      "name": "maturity_date_matches_structured_twin",
      "kind": "date_agree",
      "parsed": "maturity_date",
      "twin": "maturity_date"
    },
    {
      "name": "reference_implies_spread",
      "kind": "implication",
      "if_present": "reference_rate_type",
      "then_present": "basis_spread"
    }
  ],
  "notes": [
    "Dominant rate-bearing identifiers include 'Reference Rate and Spread <index>+<bps> Interest Rate <rate> Maturity Date <M/D/YYYY>'.",
    "Both old and new sampled eras use the same tokens; older samples sometimes omit the percent sign after Interest Rate, so the interest_rate extractor accepts an optional percent sign.",
    "PIK, floors, and cash-leg fields were not visible in the identifier strings in the bundle samples and are not required or extracted."
  ]
}
