      "group": 1,
      "type": "pct"
    },
    {
      "field": "pik_rate",
      "regex": "\\((?:I|i)ncl\\.\\s*(?P<pik_rate_pct>\\d{1,2}(?:\\.\\d{1,2})?)%\\s*PIK\\)",
      "group": 1,
      "type": "pct"
    },
    {
      "field": "maturity_date",
      "regex": "\\bMaturity\\s+(?P<maturity_date>\\d{2}/\\d{2}/\\d{2})\\b",
      "group": 1,
      "type": "date_mdy"
    },
    {
      "field": "initial_acquisition_date",
      "regex": "\\bInitial Acquisition Date\\s+(?P<initial_acquisition_date>\\d{2}/\\d{2}/\\d{2})\\b",
      "group": 1,
      "type": "date_mdy"
    }
