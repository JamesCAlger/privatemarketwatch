{
  "schema": "agentA-identifier-anchors.v1",
  "cik": "0001925309",
  "entity_name": "Sixth Street Lending Partners",
  "anchors": [
    {
      "label": "SECDEBT",
      "regex": "^Debt Investments(?:\\s|$)"
    },
    {
      "label": "EQUITY",
      "regex": "^Equity(?: and Other)? Investments(?:\\s|$)"
    },
    {
      "label": "ASSETTYPE",
      "regex": "^(?:Debt Investments|Equity(?: and Other)? Investments)(?:\\s+[A-Z][A-Za-z,& -]+)?$"
    },
    {
      "label": "MAT",
      "regex": "\\b(?:Initial\\s+)?Acquisition Date\\s+\\d{1,2}/\\d{1,2}/\\d{4}\\b|\\bdue\\s+\\d{1,2}/\\d{4}\\b"
    },
    {
      "label": "REFRATE",
      "regex": "\\bReference Rate(?: and Spread)?(?:\\s+(?:SOFR|STIBOR|S|E|N|\\$)\\s*\\+\\s*\\d|\\s+\\d+(?:\\.\\d+)?\\s*%|\\s+Interest Rate)"
    },
    {
      "label": "RATE",
      "regex": "\\bInterest Rate\\s+\\d+(?:\\.\\d+)?\\s*%"
    },
    {
      "label": "AGGREGATE",
      "regex": "^Total Investments$"
    },
    {
      "label": "EQUITY",
      "regex": "^Structured Credit Partners JV, LLC$"
    }
  ],
  "notes": "Anchors recognize section headings, aggregate total lines present in none_examples, the named JV line present in none_examples, and the debt identifier markers embedded in the bundle, including floating spread references and fixed-rate Reference Rate forms observed across 2023-2026 samples. Evidence CLI roam could not be used because pandas is unavailable in this worker environment."
}
